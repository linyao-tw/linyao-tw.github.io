---
import BaseLayout from "../layouts/BaseLayout.astro";
import { brand } from "../lib/copy";
import { site } from "../lib/site";
---

<BaseLayout title={`404 — 找不到頁面｜${site.name}`} description="這個頁面不存在，或是已經被移動了。" noindex>
	<main class="nf" id="main">
		<p class="code" aria-hidden="true">404</p>
		<h1 class="h">找不到這個頁面</h1>
		<p class="p">這個網址不存在，或是內容已經被移動了。</p>
		<a class="back" href="/">回到首頁 ↗</a>
		<p class="eq" aria-hidden="true">{brand.equation}</p>
	</main>
</BaseLayout>

<style>
	.nf {
		min-height: 100svh;
		display: grid;
		align-content: center;
		gap: 1rem;
		padding: var(--edge);
		max-width: 48rem;
	}

	.code {
		font-family: var(--font-mono);
		font-size: clamp(4rem, 22vw, 12rem);
		font-weight: 700;
		line-height: 0.82;
		letter-spacing: -0.04em;
		color: var(--accent);
	}

	.h {
		font-family: var(--font-cjk);
		font-weight: 700;
		font-size: clamp(1.5rem, 5vw, 2.75rem);
		line-height: 1.3;
		letter-spacing: 0.02em;
		color: var(--ink);
	}

	.p {
		font-family: var(--font-cjk);
		font-size: 0.95rem;
		line-height: 2;
		color: var(--dim);
	}

	.back {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		margin-block-start: 1rem;
		padding-inline: 1.25rem;
		border: var(--hairline) solid var(--ink);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.2em;
		color: var(--ink);
	}

	.back:hover,
	.back:focus-visible {
		background: var(--ink);
		color: var(--paper-hi);
	}

	.eq {
		margin-block-start: 2rem;
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.24em;
		color: var(--quiet);
	}
</style>
