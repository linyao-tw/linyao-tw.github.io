---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import Credibility from "../components/sections/Credibility.astro";
import Cta from "../components/sections/Cta.astro";
import Hero from "../components/sections/Hero.astro";
import Intro from "../components/sections/Intro.astro";
import Manifesto from "../components/sections/Manifesto.astro";
import Marquee from "../components/sections/Marquee.astro";
import Process from "../components/sections/Process.astro";
import Services from "../components/sections/Services.astro";
import InquiryDialog from "../components/ui/InquiryDialog.astro";
import Motion from "../components/ui/Motion.astro";
import { hero } from "../lib/copy";
import { site } from "../lib/site";
---

<BaseLayout
	title={`${site.name} ${site.nameEn}｜${hero.headline}`}
	description="麟曜數位工作室 LINYAO DIGITAL STUDIO 是一間以設計與技術為核心的獨立數位工作室，結合設計、程式與動態特效，提供品牌設計、網頁設計、系統開發與創意開發服務。你敢想像，我們敢做出來。"
>
	<a class="skip-link" href="#main">跳至主要內容</a>
	<Header />
	<main id="main">
		<Hero />
		<Intro />
		<Services />
		<Manifesto />
		<Credibility />
		<Process />
		<Marquee />
		<Cta />
	</main>
	<Footer />
	<InquiryDialog />
	<Motion />
</BaseLayout>
