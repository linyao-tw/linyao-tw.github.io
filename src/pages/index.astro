---
import SiteLayout from "../layouts/SiteLayout.astro";

const versions = [
	{ n: "01", slug: "design-01", title: "EDITORIAL / SWISS", zh: "編輯式瑞士版面", note: "Strict grid, oversized grotesque, cropped orange disc, heavy rules." },
	{ n: "02", slug: "design-02", title: "KINETIC TYPOGRAPHY", zh: "動態字體", note: "Type is the architecture. Oversized CJK glyphs travelling across sections." },
	{ n: "03", slug: "design-03", title: "SPATIAL / CSS 3D", zh: "空間平面", note: "Three.js art direction without WebGL — perspective corridors and floating slabs." },
	{ n: "04", slug: "design-04", title: "PRINT / POSTER SYSTEM", zh: "印刷系統", note: "Halftone, registration marks, crop marks, paper grain, technical catalogue." },
	{ n: "05", slug: "design-05", title: "GEOMETRIC ARCHITECTURE", zh: "幾何建築", note: "Massive planes, corridors, negative space, one huge circular light." },
	{ n: "06", slug: "design-06", title: "MOTION SYSTEM", zh: "動態系統", note: "Scroll-linked timeline, pinning, horizontal sequence, a travelling orange rail." },
	{ n: "07", slug: "design-07", title: "DARK GRAPHITE", zh: "石墨暗調", note: "Graphite fields, flat orange light, cinematic pacing, extreme restraint." },
	{ n: "08", slug: "design-08", title: "SYSTEM / CODE / GRID", zh: "系統網格", note: "Monospace notation, node graphs, modules and data routes — not a dashboard." },
	{ n: "09", slug: "design-09", title: "ORGANIC GEOMETRY", zh: "有機幾何", note: "Contour fields, flowing bands, curved clipping, serif Chinese display." },
	{ n: "10", slug: "design-10", title: "EXPERIMENTAL", zh: "實驗性", note: "Spatial index navigation, masked full-viewport transitions, editorial chaos on a strict grid." }
];
---

<SiteLayout title="LINYAO DIGITAL STUDIO — Design Directions Index" description="Ten homepage art directions for 麟曜數位工作室 LINYAO DIGITAL STUDIO." bodyClass="index-page">
	<main class="wrap">
		<header class="head">
			<p class="mark">麟曜數位工作室<span>LINYAO DIGITAL STUDIO</span></p>
			<h1>DESIGN DIRECTIONS<span aria-hidden="true">/ 10</span></h1>
			<p class="note">Ten complete homepage directions for the same brand. Same copy, same palette, ten art directors.</p>
		</header>

		<ol class="list">
			{
				versions.map(v => (
					<li>
						<a href={`/${v.slug}`}>
							<span class="num">{v.n}</span>
							<span class="body">
								<span class="title">{v.title}</span>
								<span class="zh">{v.zh}</span>
								<span class="desc">{v.note}</span>
							</span>
							<span class="go" aria-hidden="true">
								↗
							</span>
						</a>
					</li>
				))
			}
		</ol>

		<footer class="foot">
			<span>DESIGN × CODE × MOTION</span>
			<a href="mailto:contact@linyao.tw">contact@linyao.tw</a>
		</footer>
	</main>
</SiteLayout>

<style>
	.wrap {
		max-width: 72rem;
		margin-inline: auto;
		padding: clamp(2rem, 6vw, 5rem) var(--gutter) 4rem;
		font-family: var(--font-mono);
	}

	.mark {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: color-mix(in oklab, var(--graphite) 70%, transparent);
	}

	h1 {
		margin-top: 1.5rem;
		font-family: var(--font-grotesk);
		font-size: clamp(2.25rem, 7vw, 4.5rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 0.95;
		color: var(--graphite);
		display: flex;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
	}

	h1 span {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 400;
		letter-spacing: 0.1em;
		color: var(--orange);
	}

	.note {
		margin-top: 1rem;
		max-width: 46rem;
		font-size: 0.8125rem;
		line-height: 1.7;
		color: color-mix(in oklab, var(--graphite) 80%, transparent);
	}

	.list {
		margin-top: 3.5rem;
		border-top: 1px solid var(--rule);
	}

	.list a {
		display: grid;
		grid-template-columns: 4rem 1fr 2rem;
		align-items: baseline;
		gap: 1rem;
		padding: 1.25rem 0.5rem;
		border-bottom: 1px solid var(--rule);
		transition: background 0.2s ease;
	}

	.list a:hover,
	.list a:focus-visible {
		background: color-mix(in oklab, var(--orange) 12%, transparent);
	}

	.num {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--orange);
		letter-spacing: -0.02em;
	}

	.body {
		display: block;
	}

	.title {
		display: block;
		font-family: var(--font-grotesk);
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--graphite);
	}

	.zh {
		display: block;
		margin-top: 0.125rem;
		font-size: 0.8125rem;
		color: color-mix(in oklab, var(--graphite) 75%, transparent);
	}

	.desc {
		display: block;
		margin-top: 0.5rem;
		font-size: 0.75rem;
		line-height: 1.6;
		color: color-mix(in oklab, var(--graphite) 65%, transparent);
	}

	.go {
		justify-self: end;
		color: var(--orange);
		font-size: 1rem;
	}

	.foot {
		margin-top: 3rem;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		color: color-mix(in oklab, var(--graphite) 70%, transparent);
	}

	.foot a:hover {
		color: var(--orange);
	}

	@media (max-width: 40rem) {
		.list a {
			grid-template-columns: 3rem 1fr 1.5rem;
			gap: 0.75rem;
		}
	}
</style>
