---
/**
 * design-04 · sheet 02 — statement
 *
 * The whitespace plate. One measured headline, one narrow column of body text
 * pushed to the outer margin, a dimension line under the type and a dashed fold
 * across the bottom third. Nothing else on the sheet.
 */
import { intro } from "../../lib/copy";
import Plate from "./Plate.astro";
---

<Plate as="section" id="statement" labelledby="statement-h" plate="PL. 02 — STATEMENT" sheet="02/09" pad="xl">
	<div class="wrap">
		<div class="type">
			<h2 class="h" id="statement-h">
				{intro.headlineParts.map((part, i) => <span class:list={["ln", { ind: i === 1 }]}>{part}</span>)}
			</h2>
			<p class="dim" aria-hidden="true"><span class="t">MEASURE 02.1<span class="more">— GROTESK 800 / TRACK −0.02EM</span></span></p>
		</div>

		<div class="col">
			<p class="side" aria-hidden="true">STATEMENT · 陳述</p>
			<p class="lede">{intro.body.map(line => <span class="l">{line}</span>)}</p>
			<p class="ref" aria-hidden="true">REF. 02.1 — 3 LINES / SET SOLID</p>
		</div>

		<p class="fold" aria-hidden="true"><span>FOLD</span></p>
	</div>
</Plate>

<style>
	.wrap {
		position: relative;
		display: grid;
		gap: clamp(2.5rem, 6vw, 5rem);
	}

	.side {
		font-family: var(--font-mono);
		font-size: var(--mono);
		letter-spacing: var(--track);
		color: var(--accent-text);
		padding-bottom: 0.55rem;
		border-bottom: 1px solid var(--rule-soft);
	}

	.h {
		font-family: var(--font-cjk);
		font-weight: 800;
		font-size: clamp(2.15rem, 7.4vw, 5.75rem);
		line-height: 1.02;
		letter-spacing: 0.005em;
		color: var(--ink-black);
	}

	.ln {
		display: block;
	}

	.dim {
		position: relative;
		margin-top: clamp(1.25rem, 2.5vw, 2rem);
		height: 1px;
		background: var(--rule);
	}

	.dim::before,
	.dim::after {
		content: "";
		position: absolute;
		top: -0.3rem;
		width: 1px;
		height: 0.65rem;
		background: var(--rule);
	}

	.dim::before {
		left: 0;
	}

	.dim::after {
		right: 0;
	}

	.dim .t {
		position: absolute;
		top: -0.55rem;
		left: 1.1rem;
		padding-inline: 0.5rem;
		background: var(--paper-hi);
		font-family: var(--font-mono);
		font-size: var(--mono);
		letter-spacing: 0.1em;
		color: color-mix(in oklab, currentColor 55%, transparent);
		white-space: nowrap;
	}

	.more {
		display: none;
	}

	@media (min-width: 40rem) {
		.more {
			display: inline;
		}
	}

	.col {
		display: grid;
		gap: 1rem;
		align-content: end;
	}

	.lede {
		display: grid;
		gap: 0.35rem;
		font-family: var(--font-cjk);
		font-size: clamp(0.95rem, 0.9rem + 0.35vw, 1.15rem);
		line-height: 1.85;
		letter-spacing: 0.03em;
		color: var(--ink);
	}

	.lede .l {
		display: block;
	}

	.ref {
		font-family: var(--font-mono);
		font-size: var(--mono);
		letter-spacing: 0.1em;
		color: color-mix(in oklab, currentColor 48%, transparent);
		padding-top: 0.6rem;
		border-top: 1px solid var(--rule-faint);
	}

	.fold {
		position: relative;
		border-top: 1px dashed var(--rule-soft);
		height: 0;
	}

	.fold span {
		position: absolute;
		top: -0.55rem;
		right: 0;
		padding-left: 0.6rem;
		background: var(--paper-hi);
		font-family: var(--font-mono);
		font-size: var(--mono);
		letter-spacing: var(--track);
		color: color-mix(in oklab, currentColor 42%, transparent);
	}

	@media (min-width: 60rem) {
		.wrap {
			grid-template-columns: minmax(0, 1fr) minmax(0, 19rem);
			column-gap: clamp(2rem, 6vw, 6rem);
			align-items: end;
		}

		.type {
			grid-column: 1;
		}

		.col {
			grid-column: 2;
			padding-bottom: 0.5rem;
		}

		.fold {
			grid-column: 1 / -1;
			margin-top: clamp(2rem, 6vw, 5rem);
		}

		.ind {
			padding-left: 6vw;
		}
	}
</style>
