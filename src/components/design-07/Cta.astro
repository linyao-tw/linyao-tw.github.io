---
import { brand, cta } from "../../lib/copy";
import Beam from "./Beam.astro";
---

<section class="cta" id="contact" aria-labelledby="d07-cta-h">
	<div class="scene" aria-hidden="true">
		<span class="slab"></span>
		<Beam
			shape="polygon(40% 100%, 100% 46%, 100% 48.5%, 40% 102.5%)"
			seed="polygon(40% 100%, 40% 100%, 40% 102.5%, 40% 102.5%)"
			shapeSm="polygon(66% 100%, 100% 58%, 100% 61%, 66% 103%)"
			seedSm="polygon(66% 100%, 66% 100%, 66% 103%, 66% 103%)"
			drift={-6}
			speed={1.7}
		/>
	</div>

	<div class="inner d07-shell">
		<p class="d07-run" data-mark><span>CONTACT</span></p>

		<div class="col">
			<h2 id="d07-cta-h" class="hl" lang="zh-Hant" data-d07-reveal>
				<span>{cta.headlineParts[0]}</span>
				<span>{cta.headlineParts[1]}</span>
			</h2>

			<div class="prose" lang="zh-Hant" data-d07-reveal>
				{cta.body.map(line => <p>{line}</p>)}
			</div>

			<div class="act" data-d07-reveal>
				<button class="btn" type="button" data-d07-open-inquiry>{cta.button}</button>
				<a class="mail" href={`mailto:${brand.email}`}>{brand.email}</a>
			</div>
		</div>
	</div>
</section>

<style>
	.cta {
		position: relative;
		background: var(--d07-black);
		overflow: clip;
		isolation: isolate;
	}

	.scene {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: clip;
	}

	.slab {
		position: absolute;
		top: 0;
		bottom: 0;
		right: 0;
		width: 38%;
		display: block;
		background: var(--d07-graphite);
	}

	.inner {
		position: relative;
		z-index: 1;
		padding-block: clamp(6rem, 18vh, 13rem) clamp(7rem, 20vh, 15rem);
	}

	.col {
		max-width: 34rem;
	}

	.hl {
		font-family: var(--font-cjk);
		font-size: clamp(1.75rem, 4.8vw, 3.75rem);
		font-weight: 400;
		line-height: 1.7;
		letter-spacing: 0.14em;
		color: var(--d07-text);
	}

	.hl span {
		display: block;
		margin-right: -0.14em;
	}

	.prose {
		margin-top: clamp(2rem, 6vh, 3.5rem);
		font-family: var(--font-cjk);
		font-size: clamp(0.875rem, 1.05vw, 1rem);
		font-weight: 300;
		line-height: 2.1;
		letter-spacing: 0.09em;
		color: var(--d07-mute);
	}

	.act {
		display: flex;
		align-items: center;
		gap: clamp(1.25rem, 4vw, 3rem);
		flex-wrap: wrap;
		margin-top: clamp(2.75rem, 8vh, 5rem);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		min-height: 3.25rem;
		padding-inline: clamp(1.5rem, 4vw, 2.75rem);
		background: var(--orange);
		color: var(--d07-void);
		font-family: var(--font-cjk);
		font-size: 0.875rem;
		font-weight: 400;
		letter-spacing: 0.22em;
		border: var(--hairline) solid var(--orange);
		transition:
			background-color 0.3s ease,
			color 0.3s ease;
	}

	.btn:hover,
	.btn:focus-visible {
		background: transparent;
		color: var(--orange);
	}

	.mail {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		color: var(--d07-text);
		border-bottom: var(--hairline) solid var(--d07-line);
		transition:
			color 0.3s ease,
			border-color 0.3s ease;
	}

	.mail:hover {
		color: var(--orange);
		border-bottom-color: var(--orange);
	}

	@media (max-width: 52rem) {
		.slab {
			top: auto;
			left: 0;
			right: 0;
			width: auto;
			height: 16%;
		}
	}
</style>
