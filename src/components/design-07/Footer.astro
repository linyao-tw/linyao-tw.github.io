---
import { brand, nav } from "../../lib/copy";
---

<footer class="ft">
	<div class="d07-shell">
		<div class="top">
			<div class="mark">
				<p class="en">{brand.nameEn}</p>
				<p class="zh" lang="zh-Hant">{brand.nameZh}</p>
				<p class="eq">{brand.equation}</p>
			</div>

			<nav class="cols" aria-label="頁尾導覽">
				<ul>
					{
						nav.map(item => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="reach">
				<a class="mail" href={`mailto:${brand.email}`}>{brand.email}</a>
				<button class="ask" type="button" data-d07-open-inquiry>我要詢案 ↗</button>
			</div>
		</div>

		<div class="base">
			<span class="d07-slit" aria-hidden="true"></span>
			<p class="cr">{brand.copyright}</p>
			<a class="top-link" href="#main">BACK TO TOP ↑</a>
		</div>
	</div>
</footer>

<style>
	.ft {
		background: var(--d07-void);
		border-top: var(--hairline) solid var(--d07-line-soft);
		padding-block: clamp(3.5rem, 10vh, 6.5rem) clamp(1.5rem, 4vh, 2.5rem);
	}

	.top {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4rem);
		padding-bottom: clamp(3rem, 9vh, 6rem);
	}

	.mark .en {
		font-size: clamp(1rem, 2.2vw, 1.5rem);
		font-weight: 300;
		letter-spacing: 0.28em;
		margin-right: -0.28em;
		color: var(--d07-text);
	}

	.mark .zh {
		margin-top: 0.75rem;
		font-family: var(--font-cjk);
		font-size: 0.8125rem;
		font-weight: 300;
		letter-spacing: 0.24em;
		color: var(--d07-mute);
	}

	.mark .eq {
		margin-top: clamp(1.5rem, 4vh, 2.5rem);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.32em;
		color: var(--d07-dim);
	}

	.cols ul {
		display: grid;
		gap: 0.25rem;
	}

	.cols a {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.26em;
		color: var(--d07-mute);
		transition: color 0.3s ease;
	}

	.cols a:hover {
		color: var(--d07-text);
	}

	.reach {
		display: grid;
		align-content: start;
		justify-items: start;
		gap: clamp(1rem, 3vh, 1.75rem);
	}

	.mail {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		color: var(--d07-text);
		border-bottom: var(--hairline) solid var(--d07-line);
		transition:
			color 0.3s ease,
			border-color 0.3s ease;
	}

	.mail:hover {
		color: var(--orange);
		border-bottom-color: var(--orange);
	}

	.ask {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding-inline: 1.25rem;
		border: var(--hairline) solid var(--d07-line);
		font-family: var(--font-cjk);
		font-size: 0.8125rem;
		letter-spacing: 0.18em;
		color: var(--d07-text);
		transition:
			border-color 0.3s ease,
			color 0.3s ease;
	}

	.ask:hover,
	.ask:focus-visible {
		border-color: var(--orange);
		color: var(--orange);
	}

	.base {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: clamp(0.75rem, 2vw, 1.5rem);
		padding-top: clamp(1.25rem, 3vh, 2rem);
		border-top: var(--hairline) solid var(--d07-line-soft);
	}

	.base .d07-slit {
		height: 0.75rem;
	}

	.cr {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.24em;
		color: var(--d07-dim);
	}

	.top-link {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.28em;
		color: var(--d07-dim);
		transition: color 0.3s ease;
	}

	.top-link:hover {
		color: var(--orange);
	}

	@media (max-width: 60rem) {
		.top {
			grid-template-columns: minmax(0, 1fr);
			gap: clamp(2.5rem, 7vh, 4rem);
		}
	}
</style>
