---
import { brand, inquiryFields } from "../../lib/copy";
---

<dialog class="dlg" id="d07-inquiry" aria-labelledby="d07-dlg-h">
	<div class="sheet">
		<div class="bar">
			<p class="tag">INQUIRY / 詢案</p>
			<button class="x" type="button" data-d07-close-inquiry>
				CLOSE <span aria-hidden="true">✕</span>
			</button>
		</div>

		<div class="head">
			<span class="d07-slit" aria-hidden="true"></span>
			<div>
				<h2 id="d07-dlg-h" lang="zh-Hant">我要詢案</h2>
				<p class="sub" lang="zh-Hant">留下你的專案輪廓，我們會在兩個工作日內回覆。</p>
			</div>
		</div>

		<form class="form" id="d07-inquiry-form" novalidate={false}>
			<div class="fields">
				{
					inquiryFields.map((field, i) => (
						<p class="field">
							<label for={`d07-f-${field.name}`}>
								{field.label}
								{field.required && (
									<span class="req" aria-hidden="true">
										*
									</span>
								)}
							</label>
							<input id={`d07-f-${field.name}`} name={field.name} type={field.type} autocomplete={field.autocomplete} required={field.required} autofocus={i === 0} />
						</p>
					))
				}

				<p class="field field-wide">
					<label for="d07-f-message">
						需求說明 / MESSAGE<span class="req" aria-hidden="true">*</span>
					</label>
					<textarea id="d07-f-message" name="message" rows="5" required></textarea>
				</p>
			</div>

			<div class="foot">
				<button class="send" type="submit">送出詢問 ↗</button>
				<p class="note">送出後會開啟你的郵件軟體，寄件至 {brand.email}</p>
			</div>

			<p class="status" id="d07-inquiry-status" role="status"></p>
		</form>
	</div>
</dialog>

<style>
	.dlg {
		width: min(58rem, calc(100vw - 2rem));
		max-width: none;
		max-height: min(92svh, 56rem);
		margin: auto;
		padding: 0;
		border: var(--hairline) solid var(--d07-line);
		background: var(--d07-black);
		color: var(--d07-text);
		overflow: hidden;
	}

	.dlg::backdrop {
		background: rgb(14 14 13 / 0.92);
	}

	.sheet {
		display: grid;
		max-height: min(92svh, 56rem);
		overflow-y: auto;
		padding: clamp(1rem, 3vw, 2rem) clamp(1.25rem, 4vw, 3rem) clamp(2rem, 5vw, 3rem);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: clamp(1.5rem, 4vh, 2.5rem);
	}

	.tag {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.32em;
		color: var(--d07-dim);
	}

	.x {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding-inline: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.28em;
		color: var(--d07-mute);
		transition: color 0.3s ease;
	}

	.x:hover {
		color: var(--orange);
	}

	.head {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: clamp(1rem, 3vw, 1.75rem);
		padding-bottom: clamp(2rem, 5vh, 3rem);
		border-bottom: var(--hairline) solid var(--d07-line-soft);
	}

	.head .d07-slit {
		height: 100%;
	}

	.head h2 {
		font-family: var(--font-cjk);
		font-size: clamp(1.375rem, 3vw, 2rem);
		font-weight: 400;
		line-height: 1.6;
		letter-spacing: 0.16em;
		color: var(--d07-text);
	}

	.sub {
		margin-top: 0.625rem;
		font-family: var(--font-cjk);
		font-size: 0.8125rem;
		font-weight: 300;
		line-height: 1.9;
		letter-spacing: 0.08em;
		color: var(--d07-mute);
	}

	.fields {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1.25rem, 3vw, 2rem);
		padding-block: clamp(2rem, 5vh, 3rem);
	}

	.field-wide {
		grid-column: 1 / -1;
	}

	.field label {
		display: block;
		margin-bottom: 0.625rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--d07-dim);
	}

	.req {
		margin-left: 0.375rem;
		color: var(--orange);
	}

	.field input,
	.field textarea {
		display: block;
		width: 100%;
		padding: 0.75rem 0;
		background: transparent;
		border: 0;
		border-bottom: var(--hairline) solid var(--d07-line);
		font-family: var(--font-cjk);
		font-size: 0.9375rem;
		font-weight: 300;
		letter-spacing: 0.06em;
		color: var(--d07-text);
		transition: border-color 0.3s ease;
	}

	.field textarea {
		resize: vertical;
		line-height: 1.9;
	}

	.field input:hover,
	.field textarea:hover,
	.field input:focus,
	.field textarea:focus {
		border-bottom-color: var(--orange);
	}

	.field input:focus-visible,
	.field textarea:focus-visible {
		outline-offset: 0.25rem;
	}

	.foot {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 3vw, 2rem);
		flex-wrap: wrap;
		padding-top: clamp(1.5rem, 4vh, 2.25rem);
		border-top: var(--hairline) solid var(--d07-line-soft);
	}

	.send {
		display: inline-flex;
		align-items: center;
		min-height: 3rem;
		padding-inline: clamp(1.5rem, 4vw, 2.5rem);
		background: var(--orange);
		border: var(--hairline) solid var(--orange);
		color: var(--d07-void);
		font-family: var(--font-cjk);
		font-size: 0.875rem;
		letter-spacing: 0.2em;
		transition:
			background-color 0.3s ease,
			color 0.3s ease;
	}

	.send:hover,
	.send:focus-visible {
		background: transparent;
		color: var(--orange);
	}

	.note {
		font-family: var(--font-cjk);
		font-size: 0.75rem;
		font-weight: 300;
		letter-spacing: 0.06em;
		color: var(--d07-dim);
	}

	.status:not(:empty) {
		margin-top: clamp(1rem, 3vh, 1.5rem);
		padding-top: 1rem;
		border-top: var(--hairline) solid var(--d07-line-soft);
		font-family: var(--font-cjk);
		font-size: 0.8125rem;
		font-weight: 300;
		letter-spacing: 0.08em;
		color: var(--d07-mute);
	}

	@media (max-width: 40rem) {
		.dlg {
			width: 100vw;
			max-width: 100vw;
			height: 100svh;
			max-height: 100svh;
			border: 0;
		}

		.sheet {
			max-height: 100svh;
		}

		.fields {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	const dialog = document.getElementById("d07-inquiry") as HTMLDialogElement | null;
	const form = document.getElementById("d07-inquiry-form") as HTMLFormElement | null;
	const status = document.getElementById("d07-inquiry-status");

	if (dialog && form) {
		let opener: HTMLElement | null = null;

		const open = (trigger: HTMLElement) => {
			opener = trigger;
			if (status) status.textContent = "";
			dialog.showModal();
			requestAnimationFrame(() => dialog.querySelector<HTMLInputElement>(".field input")?.focus());
		};

		document.querySelectorAll<HTMLElement>("[data-d07-open-inquiry]").forEach(btn => {
			btn.addEventListener("click", () => open(btn));
		});

		dialog.querySelectorAll<HTMLElement>("[data-d07-close-inquiry]").forEach(btn => {
			btn.addEventListener("click", () => dialog.close());
		});

		/* backdrop click: the pointer lands outside the sheet's box */
		dialog.addEventListener("click", event => {
			const box = dialog.getBoundingClientRect();
			const outside = event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom;
			if (outside) dialog.close();
		});

		dialog.addEventListener("close", () => {
			opener?.focus();
			opener = null;
		});

		form.addEventListener("submit", event => {
			event.preventDefault();
			if (!form.reportValidity()) return;

			const data = new FormData(form);
			const value = (key: string) => String(data.get(key) ?? "").trim();

			const lines = [
				`姓名 NAME: ${value("name")}`,
				`信箱 EMAIL: ${value("email")}`,
				`公司 COMPANY: ${value("company") || "—"}`,
				`預算 BUDGET: ${value("budget") || "—"}`,
				"",
				"需求說明 MESSAGE:",
				value("message")
			];

			const subject = `詢案 INQUIRY — ${value("name") || "LINYAO"}`;
			const href = `mailto:contact@linyao.tw?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;

			if (status) status.textContent = "已開啟你的郵件軟體，內容已帶入。若沒有反應，請直接寄信到 contact@linyao.tw。";
			window.location.href = href;
		});
	}
</script>
