---
import { intro } from "../../lib/copy";
---

<section class="intro" id="intro" aria-labelledby="d07-intro-h">
	<div class="d07-shell">
		<p class="d07-run" data-mark><span>INTRO</span></p>

		<div class="body-grid">
			<span class="slit d07-slit" aria-hidden="true"></span>
			<div class="col">
				<h2 id="d07-intro-h" class="hl" lang="zh-Hant" data-d07-reveal>
					<span>{intro.headlineParts[0]}</span>
					<span>{intro.headlineParts[1]}</span>
				</h2>
				<div class="prose" lang="zh-Hant" data-d07-reveal>
					{intro.body.map(line => <p>{line}</p>)}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.intro {
		position: relative;
		background: var(--d07-black);
		padding-block: clamp(6rem, 18vh, 14rem) clamp(8rem, 24vh, 18rem);
		border-top: var(--hairline) solid var(--d07-line-soft);
	}

	.body-grid {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		column-gap: clamp(1.5rem, 5vw, 4.5rem);
		margin-left: clamp(0rem, 26vw, 30rem);
	}

	.slit {
		height: 100%;
	}

	.col {
		max-width: 32rem;
	}

	.hl {
		font-family: var(--font-cjk);
		font-size: clamp(1.5rem, 3.4vw, 2.5rem);
		font-weight: 400;
		line-height: 1.75;
		letter-spacing: 0.12em;
		color: var(--d07-text);
	}

	.hl span {
		display: block;
		margin-right: -0.12em;
	}

	.prose {
		margin-top: clamp(2.5rem, 7vh, 5rem);
		font-family: var(--font-cjk);
		font-size: clamp(0.875rem, 1.05vw, 1rem);
		font-weight: 300;
		line-height: 2.1;
		letter-spacing: 0.09em;
		color: var(--d07-mute);
	}

	@media (max-width: 60rem) {
		.body-grid {
			margin-left: 0;
		}
	}
</style>
