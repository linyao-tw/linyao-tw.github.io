---
import { manifesto } from "../../lib/copy";
import Corridor from "./Corridor.astro";
---

<section class="mani" id="manifesto" aria-labelledby="d03-mani-h">
	<div class="divider">
		<Corridor variant="band" planes={5} vpx={38} vpy={47} />
	</div>

	<div class="planes">
		<h2 id="d03-mani-h">
			<span class="ln back" data-mani-back>
				<span class="txt">{manifesto.headlineParts[0]}</span>
				<span class="tag" aria-hidden="true">PLANE B · z −320</span>
			</span>
			<span class="ln fore" data-mani-fore>
				<span class="txt">{manifesto.headlineParts[1]}</span>
				<span class="tag" aria-hidden="true">PLANE C · z +064</span>
			</span>
		</h2>
	</div>

	<div class="say">
		<p class="idx" aria-hidden="true">§ 03 / STATEMENT</p>
		<div class="lines">
			{manifesto.body.map(line => <p>{line}</p>)}
		</div>
	</div>
</section>

<style>
	.mani {
		position: relative;
		background: var(--stage-near);
		color: var(--on-stage);
		overflow: clip;
		padding-bottom: clamp(4rem, 12vh, 8rem);
	}

	.divider {
		--scene-min: clamp(11rem, 26vh, 17rem);
		border-bottom: 1px solid var(--edge-soft);
	}

	.planes {
		perspective: 60rem;
		perspective-origin: 52% 46%;
		padding: clamp(4rem, 12vh, 8rem) var(--gutter) clamp(3rem, 9vh, 6rem);
		overflow: clip;
	}

	h2 {
		display: grid;
		gap: clamp(1.75rem, 5vh, 3.5rem);
		transform-style: preserve-3d;
	}

	.ln {
		position: relative;
		display: block;
		width: fit-content;
		max-width: 100%;
		font-family: var(--font-cjk);
		font-weight: 500;
		line-height: 1.25;
		white-space: nowrap;
	}

	.txt {
		display: block;
	}

	.tag {
		position: absolute;
		font-family: var(--font-mono);
		font-weight: 400;
		font-size: 0.5625rem;
		letter-spacing: 0.2em;
		white-space: nowrap;
	}

	.back {
		justify-self: start;
		margin-left: clamp(0rem, 4vw, 5rem);
		padding: clamp(0.9rem, 2vw, 1.5rem) clamp(1.1rem, 3vw, 2.5rem);
		border: 1px solid var(--edge-soft);
		border-bottom-color: var(--orange-deep);
		color: var(--on-stage-mute);
		font-size: clamp(1.65rem, 4.6vw, 3.6rem);
		letter-spacing: 0.14em;
		transform: translate3d(0, 0, calc(-13rem + var(--mz, 0rem))) rotateY(calc(11deg + var(--ptr-x, 0) * 1.2deg));
		transform-origin: 0% 50%;
	}

	.back .tag {
		top: -1.45rem;
		left: 0;
		color: var(--on-stage-mute);
	}

	.fore {
		justify-self: end;
		margin-right: clamp(0rem, 3vw, 3rem);
		padding: clamp(1.1rem, 2.4vw, 1.9rem) clamp(1.3rem, 3.4vw, 3rem);
		background: color-mix(in oklab, var(--void) 55%, transparent);
		border: 1px solid var(--edge-soft);
		border-left: 1px solid var(--orange);
		color: var(--on-stage-hi);
		font-size: clamp(2rem, 6vw, 4.5rem);
		letter-spacing: 0.1em;
		transform: translate3d(0, 0, calc(3.5rem - var(--mz, 0rem))) rotateY(calc(-6deg + var(--ptr-x, 0) * 1.2deg));
		transform-origin: 100% 50%;
	}

	.fore .tag {
		bottom: -1.45rem;
		right: 0;
		color: var(--orange);
	}

	.say {
		display: grid;
		grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
		gap: clamp(1rem, 3vw, 3rem);
		padding-inline: var(--gutter);
		border-top: 1px solid var(--edge-soft);
		padding-top: clamp(1.75rem, 5vh, 3rem);
	}

	.idx {
		font-family: var(--font-mono);
		font-size: var(--mark);
		letter-spacing: 0.16em;
		color: var(--orange);
	}

	.lines p {
		font-family: var(--font-cjk);
		font-size: clamp(0.9375rem, 1.35vw, 1.125rem);
		line-height: 2.2;
		letter-spacing: 0.1em;
		color: var(--on-stage-dim);
		max-width: 46ch;
	}

	.lines p:last-child {
		color: var(--on-stage-hi);
	}

	@media (max-width: 48rem) {
		.planes {
			perspective: 34rem;
			padding-block: clamp(3rem, 9vh, 5rem) clamp(2.25rem, 7vh, 4rem);
		}
		.ln {
			white-space: normal;
		}
		.back {
			margin-left: 0;
			font-size: clamp(1.45rem, 8vw, 2rem);
			transform: translate3d(0, 0, -4rem) rotateY(6deg);
		}
		.fore {
			margin-right: 0;
			justify-self: start;
			font-size: clamp(1.75rem, 10vw, 2.5rem);
			transform: translate3d(0, 0, 1rem) rotateY(-4deg);
		}
		.back .tag,
		.fore .tag {
			display: none;
		}
		.say {
			grid-template-columns: minmax(0, 1fr);
		}
		.divider {
			--scene-min: clamp(8rem, 20vh, 11rem);
		}
	}
</style>

<script>
	import { motion } from "../../lib/motion";

	motion(({ gsap, ScrollTrigger }) => {
		const section = document.querySelector<HTMLElement>(".mani");
		const back = document.querySelector<HTMLElement>("[data-mani-back]");
		const fore = document.querySelector<HTMLElement>("[data-mani-fore]");
		const corridor = section?.querySelector<HTMLElement>("[data-corridor]");
		if (!section) return;

		const flat = window.matchMedia("(max-width: 48rem)");

		ScrollTrigger.create({
			trigger: section,
			start: "top bottom",
			end: "bottom top",
			onUpdate: self => {
				const p = self.progress - 0.5;
				if (corridor) corridor.style.setProperty("--scrub", (p * 7).toFixed(2) + "rem");
				if (flat.matches) return;
				const mz = (p * 6).toFixed(2) + "rem";
				back?.style.setProperty("--mz", mz);
				fore?.style.setProperty("--mz", mz);
			}
		});

		gsap.from(section.querySelectorAll(".lines p"), {
			opacity: 0,
			y: 14,
			duration: 0.7,
			ease: "power2.out",
			stagger: 0.07,
			scrollTrigger: { trigger: ".mani .say", start: "top 85%" }
		});
	});
</script>
