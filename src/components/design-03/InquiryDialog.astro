---
import { brand, cta, inquiryFields } from "../../lib/copy";
---

<dialog class="dlg" id="d03-inquiry" aria-labelledby="d03-inq-h" data-inquiry>
	<div class="panel">
		<svg class="lines" viewBox="0 0 200 40" preserveAspectRatio="none" aria-hidden="true" focusable="false">
			<g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
				<line x1="168" y1="14" x2="0" y2="40"></line>
				<line x1="168" y1="14" x2="0" y2="0"></line>
				<line x1="168" y1="14" x2="0" y2="22"></line>
				<line x1="168" y1="14" x2="60" y2="40"></line>
				<line x1="168" y1="14" x2="120" y2="40"></line>
				<line x1="0" y1="14" x2="200" y2="14"></line>
			</g>
		</svg>

		<header class="head">
			<div>
				<h2 id="d03-inq-h">{cta.buttonLabel}</h2>
				<p class="sub" aria-hidden="true">INQUIRY / PLANE D · z +000</p>
			</div>
			<button type="button" class="x" data-inquiry-close>
				<span class="visually-hidden">關閉詢案表單</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="20" height="20">
					<g stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
						<line x1="5" y1="5" x2="19" y2="19"></line>
						<line x1="19" y1="5" x2="5" y2="19"></line>
					</g>
				</svg>
			</button>
		</header>

		<form class="form" data-inquiry-form novalidate>
			<div class="fields">
				{
					inquiryFields.map((f, i) => (
						<p class="field">
							<label for={`d03-f-${f.name}`}>
								<span class="fi" aria-hidden="true">
									{String(i + 1).padStart(2, "0")}
								</span>
								{f.label}
								{f.required && (
									<span class="req" aria-hidden="true">
										*
									</span>
								)}
							</label>
							<input id={`d03-f-${f.name}`} name={f.name} type={f.type} required={f.required} autocomplete={f.autocomplete} />
						</p>
					))
				}
				<p class="field wide">
					<label for="d03-f-message">
						<span class="fi" aria-hidden="true">05</span>
						專案內容 / MESSAGE
						<span class="req" aria-hidden="true">*</span>
					</label>
					<textarea id="d03-f-message" name="message" rows="4" required></textarea>
				</p>
			</div>

			<p class="err" data-inquiry-error role="alert" hidden></p>

			<footer class="foot">
				<p class="note">送出後會開啟你的郵件軟體，收件人為 {brand.email}。</p>
				<button type="submit" class="send">送出詢問 ↗</button>
			</footer>
		</form>
	</div>
</dialog>

<style>
	.dlg {
		width: min(52rem, calc(100vw - 2rem));
		max-width: none;
		max-height: min(88svh, 46rem);
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--on-stage);
		overflow: visible;
	}

	.dlg::backdrop {
		background: color-mix(in srgb, #0e0e0d 84%, transparent);
	}

	.panel {
		position: relative;
		max-height: min(88svh, 46rem);
		overflow-y: auto;
		overscroll-behavior: contain;
		background: var(--ink-black);
		border: 1px solid color-mix(in oklab, var(--paper) 22%, transparent);
		border-top: 1px solid var(--orange);
		padding: clamp(1.25rem, 3vw, 2.25rem);
		color: var(--paper);
	}

	.lines {
		position: absolute;
		inset: 0 0 auto 0;
		width: 100%;
		height: 6rem;
		color: color-mix(in oklab, var(--paper) 12%, transparent);
		pointer-events: none;
	}

	.head {
		position: relative;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		border-bottom: 1px solid color-mix(in oklab, var(--paper) 16%, transparent);
		padding-bottom: 1.15rem;
	}

	h2 {
		font-family: var(--font-cjk);
		font-weight: 500;
		font-size: clamp(1.35rem, 3vw, 1.9rem);
		letter-spacing: 0.16em;
		color: var(--paper-hi);
	}

	.sub {
		margin-top: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.2em;
		color: var(--orange);
	}

	.x {
		width: 2.75rem;
		height: 2.75rem;
		display: grid;
		place-items: center;
		border: 1px solid color-mix(in oklab, var(--paper) 22%, transparent);
		color: var(--paper);
		flex: none;
	}

	.x:hover,
	.x:focus-visible {
		border-color: var(--orange);
		color: var(--orange);
	}

	.form {
		position: relative;
		padding-top: 1.5rem;
	}

	.fields {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.35rem clamp(1rem, 3vw, 2.25rem);
	}

	.field.wide {
		grid-column: 1 / -1;
	}

	label {
		display: flex;
		align-items: baseline;
		gap: 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: color-mix(in oklab, var(--paper) 66%, transparent);
		padding-bottom: 0.5rem;
	}

	.fi {
		color: var(--orange);
	}

	.req {
		color: var(--orange);
	}

	input,
	textarea {
		display: block;
		width: 100%;
		background: transparent;
		border: 0;
		border-bottom: 1px solid color-mix(in oklab, var(--paper) 28%, transparent);
		padding: 0.55rem 0;
		font-family: var(--font-grotesk);
		font-size: 1rem;
		color: var(--paper-hi);
		min-height: 2.5rem;
		border-radius: 0;
	}

	textarea {
		resize: vertical;
		line-height: 1.7;
	}

	input:focus-visible,
	textarea:focus-visible {
		outline: 0;
		border-bottom-color: var(--orange);
	}

	input:focus,
	textarea:focus {
		border-bottom-color: var(--orange);
	}

	.err {
		margin-top: 1.25rem;
		font-family: var(--font-cjk);
		font-size: 0.8125rem;
		letter-spacing: 0.08em;
		color: var(--orange);
		border-left: 1px solid var(--orange);
		padding-left: 0.75rem;
	}

	.err[hidden] {
		display: none;
	}

	.foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 1.85rem;
		padding-top: 1.25rem;
		border-top: 1px solid color-mix(in oklab, var(--paper) 16%, transparent);
	}

	.note {
		font-family: var(--font-cjk);
		font-size: 0.75rem;
		line-height: 1.9;
		letter-spacing: 0.06em;
		color: color-mix(in oklab, var(--paper) 60%, transparent);
		max-width: 34ch;
	}

	.send {
		min-height: 2.75rem;
		padding: 0.85rem 1.5rem;
		background: var(--orange-deep);
		border: 1px solid var(--orange);
		color: var(--paper-hi);
		font-family: var(--font-cjk);
		font-size: 0.9375rem;
		letter-spacing: 0.18em;
	}

	.send:hover,
	.send:focus-visible {
		background: var(--orange);
	}

	@media (max-width: 40rem) {
		.fields {
			grid-template-columns: minmax(0, 1fr);
		}
		.foot {
			flex-direction: column;
			align-items: stretch;
		}
		.send {
			width: 100%;
		}
	}
</style>

<script>
	import { initSmoothScroll } from "../../lib/motion";

	const dlg = document.querySelector<HTMLDialogElement>("[data-inquiry]");

	if (dlg && typeof dlg.showModal === "function") {
		const form = dlg.querySelector<HTMLFormElement>("[data-inquiry-form]")!;
		const err = dlg.querySelector<HTMLElement>("[data-inquiry-error]")!;
		let trigger: HTMLElement | null = null;

		const open = (from: HTMLElement) => {
			trigger = from;
			err.hidden = true;
			dlg.showModal();
			initSmoothScroll()?.stop();
			dlg.querySelector<HTMLInputElement>("input, textarea")?.focus();
		};

		document.querySelectorAll<HTMLElement>("[data-inquiry-open]").forEach(btn => {
			btn.addEventListener("click", event => {
				event.preventDefault();
				open(btn);
			});
		});

		dlg.querySelectorAll<HTMLElement>("[data-inquiry-close]").forEach(btn => {
			btn.addEventListener("click", () => dlg.close());
		});

		/* backdrop click — the panel swallows its own clicks */
		dlg.addEventListener("click", event => {
			if (event.target === dlg) dlg.close();
		});

		dlg.addEventListener("close", () => {
			initSmoothScroll()?.start();
			trigger?.focus();
			trigger = null;
		});

		form.addEventListener("submit", event => {
			event.preventDefault();
			const data = new FormData(form);
			const get = (k: string) => String(data.get(k) ?? "").trim();

			const name = get("name");
			const email = get("email");
			const message = get("message");

			if (!name || !email || !message) {
				err.hidden = false;
				err.textContent = "請填寫姓名、信箱與專案內容。";
				(!name
					? form.querySelector<HTMLInputElement>("#d03-f-name")
					: !email
						? form.querySelector<HTMLInputElement>("#d03-f-email")
						: form.querySelector<HTMLTextAreaElement>("#d03-f-message")
				)?.focus();
				return;
			}
			if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
				err.hidden = false;
				err.textContent = "信箱格式看起來不太對，請再確認一次。";
				form.querySelector<HTMLInputElement>("#d03-f-email")?.focus();
				return;
			}

			const body = [
				`姓名 / NAME: ${name}`,
				`信箱 / EMAIL: ${email}`,
				`公司・單位 / COMPANY: ${get("company") || "—"}`,
				`預算範圍 / BUDGET: ${get("budget") || "—"}`,
				"",
				"專案內容 / MESSAGE:",
				message
			].join("\n");

			const href = `mailto:contact@linyao.tw?subject=${encodeURIComponent(`詢案 / INQUIRY — ${name}`)}&body=${encodeURIComponent(body)}`;
			err.hidden = true;
			dlg.close();
			window.location.href = href;
		});
	}
</script>
