---
/**
 * 02 — the whole page's motion, in one place, one gsap.context, one Lenis.
 * Vocabulary: per-line mask reveals, scrub-linked xPercent on travelling type,
 * one letter-spacing settle, hairline scaleX draws. Nothing else.
 */
---

<script>
	import { bindAnchorScroll, motion } from "../../lib/motion";

	bindAnchorScroll();

	motion(
		({ gsap, ScrollTrigger }) => {
			document.body.classList.add("ly-js");

			/* ---------- hero: mask reveal + letter-spacing settle ---------- */
			const heroLines = document.querySelectorAll("[data-ly-hero] .ly-li");
			const tl = gsap.timeline({ defaults: { ease: "expo.out" } });

			if (heroLines.length) {
				tl.from(heroLines, { yPercent: 150, duration: 1.3, stagger: 0.085 });
			}

			document.querySelectorAll("[data-ly-track]").forEach((el, i) => {
				const from = el.getAttribute("data-ly-track") || "0.4em";
				tl.from(el, { letterSpacing: from, opacity: 0, duration: 1.5 }, 0.35 + i * 0.14);
			});

			/* ---------- every hand-broken headline: per-line masks --------- */
			gsap.utils.toArray<HTMLElement>("[data-ly-lines]").forEach(block => {
				const lines = block.querySelectorAll(".ly-li");
				if (!lines.length) return;
				gsap.from(lines, {
					yPercent: 150,
					duration: 1.05,
					ease: "expo.out",
					stagger: 0.085,
					scrollTrigger: { trigger: block, start: "top 86%" }
				});
			});

			/* ---------- hairline draws ------------------------------------- */
			gsap.utils.toArray<HTMLElement>(".ly-rule").forEach(el => {
				gsap.from(el, {
					scaleX: 0,
					ease: "none",
					scrollTrigger: { trigger: el, start: "top 96%", end: "top 68%", scrub: true }
				});
			});

			gsap.utils.toArray<HTMLElement>(".ly-strike").forEach(el => {
				gsap.from(el, {
					scaleX: 0,
					ease: "none",
					scrollTrigger: { trigger: el, start: "top 88%", end: "top 52%", scrub: true }
				});
			});

			/* ---------- hero equation band: scrubbed xPercent -------------- */
			const eqTrack = document.querySelector(".ly-eq-track");
			if (eqTrack) {
				gsap.fromTo(
					eqTrack,
					{ xPercent: 0 },
					{
						xPercent: -34,
						ease: "none",
						scrollTrigger: { trigger: ".ly-hero", start: "top top", end: "bottom top", scrub: 0.5 }
					}
				);
			}

			/* ---------- signature: one glyph, three crops, one travel ------ */
			const run = document.querySelector<HTMLElement>(".ly-run");
			if (run) {
				const crops = Array.from(run.querySelectorAll<HTMLElement>(".ly-glyph-crop"));

				const wide = window.matchMedia("(min-width: 62rem)");

				const placeCrops = () => {
					const rr = run.getBoundingClientRect();
					crops.forEach(crop => {
						if (!wide.matches) {
							crop.style.top = "";
							crop.style.height = "";
							return;
						}
						const host = crop.parentElement;
						if (!host) return;
						const hr = host.getBoundingClientRect();
						crop.style.top = `${rr.top - hr.top}px`;
						crop.style.height = `${rr.height}px`;
					});
				};

				placeCrops();
				ScrollTrigger.addEventListener("refresh", placeCrops);

				gsap.fromTo(
					".ly-glyph-track",
					{ xPercent: 17 },
					{
						xPercent: -17,
						ease: "none",
						scrollTrigger: { trigger: run, start: "top bottom", end: "bottom top", scrub: 0.6 }
					}
				);
			}

			/* ---------- service names: outline fills solid on entry -------- */
			gsap.utils.toArray<HTMLElement>(".ly-fill").forEach(el => {
				const row = el.closest("article") || el;
				gsap.fromTo(
					el,
					{ clipPath: "inset(0% 100% 0% 0%)" },
					{
						clipPath: "inset(0% 0% 0% 0%)",
						ease: "none",
						scrollTrigger: { trigger: row, start: "top 84%", end: "top 34%", scrub: true }
					}
				);
			});

			/* ---------- capability bands: counter-scrolling ---------------- */
			const mq = document.querySelector(".ly-mq");
			if (mq) {
				const range = { trigger: mq, start: "top bottom", end: "bottom top", scrub: 0.5 };
				gsap.fromTo(".ly-band-a", { xPercent: -2 }, { xPercent: -26, ease: "none", scrollTrigger: { ...range } });
				gsap.fromTo(".ly-band-b", { xPercent: -30 }, { xPercent: -4, ease: "none", scrollTrigger: { ...range } });
			}

			/* ---------- 01—05 horizontal type sequence ---------------------
			   With JS the strip is 190% wide with much larger type, so it has to
			   travel for 05 to be reachable. It must not start travelling until
			   the whole section has been on screen, otherwise 01 has already slid
			   away by the time the reader arrives. */
			const mm = gsap.matchMedia();
			mm.add("(min-width: 48rem)", () => {
				const strip = document.querySelector(".ly-strip");
				const proc = document.querySelector(".ly-proc");
				if (!strip || !proc) return;
				gsap.fromTo(
					strip,
					{ xPercent: 0 },
					{
						// 190% wide strip -> 47.4% of it overflows; 48 clears 05 of the edge
						xPercent: -48,
						ease: "none",
						scrollTrigger: { trigger: proc, start: "bottom bottom", end: "bottom 35%", scrub: 0.7 }
					}
				);
			});

			ScrollTrigger.refresh();
		},
		{ smooth: true }
	);
</script>
