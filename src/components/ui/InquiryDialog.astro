---
import { brand, inquiry } from "../../lib/copy";
---

<dialog class="dlg" id="ly-inquiry" aria-labelledby="ly-dlg-h">
	<div class="panel">
		<div class="bar">
			<p class="bar-l" id="ly-dlg-h">詢案表單</p>
			<button class="x" type="button" data-ly-close>
				<span class="visually-hidden">關閉表單</span>
				<span aria-hidden="true">關閉 ✕</span>
			</button>
		</div>

		<div class="big" aria-hidden="true">
			<span class="big-a">詢案</span>
			<span class="big-b">{brand.equation}</span>
		</div>

		<form class="form" id="ly-form" action={inquiry.action} method="post" target="ly-sink" novalidate>
			<div class="fields">
				{
					inquiry.fields.map((f, i) => (
						<p class="f">
							<label for={`ly-f-${f.key}`}>
								<span class="f-i">{String(i + 1).padStart(2, "0")}</span>
								<span class="f-t">{f.label}</span>
								{f.required && (
									<span class="f-q" aria-hidden="true">
										必填
									</span>
								)}
							</label>
							<input id={`ly-f-${f.key}`} name={f.entry} type={f.type} required={f.required} autocomplete={f.autocomplete} />
						</p>
					))
				}
				<p class="f f-wide">
					<label for={`ly-f-${inquiry.message.key}`}>
						<span class="f-i">05</span>
						<span class="f-t">{inquiry.message.label}</span>
						<span class="f-q" aria-hidden="true">必填</span>
					</label>
					<textarea id={`ly-f-${inquiry.message.key}`} name={inquiry.message.entry} rows="4" required></textarea>
				</p>
			</div>

			<p class="err" id="ly-err" role="status"></p>

			<div class="act">
				<button class="send" type="submit">送出詢問 ↗</button>
				<a class="mail" href={`mailto:${brand.email}`}>{brand.email}</a>
			</div>
		</form>
	</div>
</dialog>

<iframe class="sink" name="ly-sink" title="表單送出結果" aria-hidden="true" tabindex="-1"></iframe>

<script>
	const dlg = document.getElementById("ly-inquiry") as HTMLDialogElement | null;
	const form = document.getElementById("ly-form") as HTMLFormElement | null;
	const err = document.getElementById("ly-err");

	const FIELD = {
		name: "entry.1762185661",
		email: "entry.850495699",
		message: "entry.419321590"
	};

	const COPY = {
		sending: "正在送出…",
		sent: "已送出，我們會盡快與你聯絡。",
		invalid: "請填寫姓名、信箱與專案內容。",
		failed: "送出失敗，請改用下方信箱與我們聯絡。"
	};

	if (dlg && form) {
		let opener: HTMLElement | null = null;

		const CLOSE_MS = 420;
		const reduced = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		let closeTimer = 0;

		/** play the close state, then actually close */
		const dismiss = () => {
			if (!dlg.open || dlg.classList.contains("is-closing")) return;
			if (reduced()) {
				dlg.close();
				return;
			}
			dlg.classList.add("is-closing");
			closeTimer = window.setTimeout(() => {
				dlg.classList.remove("is-closing");
				dlg.close();
			}, CLOSE_MS);
		};

		const open = (trigger: HTMLElement) => {
			window.clearTimeout(closeTimer);
			dlg.classList.remove("is-closing");
			// opened from inside the full-screen menu: close that first so the
			// scroll lock is released and focus has somewhere sane to return to
			const menu = document.getElementById("ly-menu");
			const burger = document.getElementById("ly-burger");
			if (menu && burger && !menu.hidden && menu.contains(trigger)) {
				burger.click();
				opener = burger;
			} else {
				opener = trigger;
			}
			if (err) err.textContent = "";
			dlg.showModal();
			dlg.querySelector<HTMLInputElement>("input, textarea")?.focus();
		};

		document.querySelectorAll<HTMLElement>("[data-ly-inquiry]").forEach(btn => {
			btn.addEventListener("click", () => open(btn));
		});

		dlg.querySelectorAll<HTMLElement>("[data-ly-close]").forEach(btn => {
			btn.addEventListener("click", dismiss);
		});

		dlg.addEventListener("click", event => {
			if (event.target === dlg) dismiss();
		});

		// Esc would close instantly and skip the animation
		dlg.addEventListener("cancel", event => {
			event.preventDefault();
			dismiss();
		});

		dlg.addEventListener("close", () => {
			opener?.focus();
			opener = null;
		});

		const send = form.querySelector<HTMLButtonElement>('button[type="submit"]');

		form.addEventListener("submit", async event => {
			event.preventDefault();
			if (form.dataset.sending === "1") return;

			const data = new FormData(form);
			const at = (entry: string) => String(data.get(entry) ?? "").trim();

			const name = at(FIELD.name);
			const email = at(FIELD.email);
			const message = at(FIELD.message);

			if (!name || !email || !message) {
				if (err) err.textContent = COPY.invalid;
				const first = !name ? "name" : !email ? "email" : "message";
				document.getElementById(`ly-f-${first}`)?.focus();
				return;
			}

			form.dataset.sending = "1";
			if (send) send.disabled = true;
			if (err) err.textContent = COPY.sending;

			try {
				// Google Forms sends no CORS headers, so the response is opaque —
				// urlencoded POST is a simple request, so it still reaches them.
				await fetch(form.action, {
					method: "POST",
					mode: "no-cors",
					headers: { "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8" },
					body: new URLSearchParams(data as unknown as Record<string, string>)
				});
				if (err) err.textContent = COPY.sent;
				form.reset();
				window.setTimeout(dismiss, 1400);
			} catch {
				// network refused the request entirely — fall back to a native
				// post into the hidden frame so the response is not lost
				if (err) err.textContent = COPY.failed;
				form.submit();
			} finally {
				form.dataset.sending = "";
				if (send) send.disabled = false;
			}
		});
	}
</script>

<style>
	.dlg {
		border: 0;
		padding: 0;
		/* Opening animates from @starting-style. Closing is driven by the
		   script, so `overlay`/`display` are deliberately not transitioned —
		   they would keep the invisible dialog in the top layer after
		   close(), where it would still swallow clicks. */
		opacity: 0;
		transform: translateY(1.25rem) scale(0.985);
		transition:
			opacity 300ms ease,
			transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
		max-width: min(56rem, 100vw - 1.5rem);
		width: 100%;
		max-height: 92svh;
		overflow: hidden;
		background: var(--paper-hi);
		color: var(--ink);
		margin: auto;
	}

	.dlg[open] {
		opacity: 1;
		transform: none;
	}

	/* entry state must be declared after the open state */
	@starting-style {
		.dlg[open] {
			opacity: 0;
			transform: translateY(1.25rem) scale(0.985);
		}
	}

	.dlg::backdrop {
		/* ::backdrop cannot see the page custom properties — the --void tone, literal */
		background: rgb(14 14 13 / 0);
		transition: background 300ms ease;
	}

	.dlg[open]::backdrop {
		background: rgb(14 14 13 / 0.7);
	}

	@starting-style {
		.dlg[open]::backdrop {
			background: rgb(14 14 13 / 0);
		}
	}

	/* The script adds this, waits for the transition, then calls close() —
	   a CSS-only close depends on `overlay`, which only Chrome supports. */
	.dlg[open].is-closing {
		opacity: 0;
		transform: translateY(1.25rem) scale(0.985);
	}

	.dlg[open].is-closing::backdrop {
		background: rgb(14 14 13 / 0);
	}

	@media (prefers-reduced-motion: reduce) {
		.dlg,
		.dlg::backdrop {
			transition: none;
		}

		.dlg,
		.dlg[open].is-closing {
			transform: none;
		}
	}

	.sink {
		display: none;
	}

	.panel {
		display: grid;
		grid-template-rows: auto auto minmax(0, 1fr);
		gap: 0;
		max-height: 92svh;
		border: var(--hairline) solid var(--ink);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.6rem clamp(1rem, 3vw, 2rem);
		border-bottom: var(--hairline) solid var(--ink);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.18em;
	}

	.bar-l {
		color: var(--ink);
	}

	.x {
		min-height: 2.75rem;
		display: inline-flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		color: var(--accent-txt);
	}

	.big {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: clamp(1rem, 3vw, 1.75rem) clamp(1rem, 3vw, 2rem) 0.7rem;
		margin-bottom: -0.7rem;
		overflow: clip;
	}

	.big-a {
		font-family: var(--font-cjk);
		font-weight: 700;
		font-size: clamp(1.9rem, 6.5vw, 3.25rem);
		line-height: 0.82;
		letter-spacing: 0.02em;
		/* solid accent — display weight and size, so pure orange is fine here */
		color: var(--accent);
	}

	.big-b {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		color: var(--dim);
		white-space: nowrap;
	}

	.form {
		display: grid;
		gap: clamp(1.25rem, 3vh, 1.75rem);
		padding: clamp(1rem, 3vw, 1.75rem) clamp(1rem, 3vw, 2rem) clamp(1.25rem, 3vw, 2rem);
		overflow-y: auto;
	}

	.fields {
		display: grid;
		gap: 1.1rem;
	}

	.f {
		display: grid;
		gap: 0.4rem;
	}

	.f label {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		color: var(--quiet);
	}

	.f-i {
		color: var(--accent-txt);
	}

	.f-q {
		margin-inline-start: auto;
		font-family: var(--font-cjk);
		letter-spacing: 0.16em;
		color: var(--accent-txt);
	}

	.f input,
	.f textarea {
		width: 100%;
		min-height: 2.75rem;
		padding: 0.5rem 0.15rem;
		background: transparent;
		border: 0;
		border-bottom: var(--hairline) solid var(--rule);
		border-radius: 0;
		font-family: var(--font-cjk);
		font-size: 1rem;
		letter-spacing: 0.04em;
		color: var(--ink);
	}

	.f textarea {
		resize: vertical;
		line-height: 1.7;
	}

	.f input:focus,
	.f textarea:focus {
		outline: 0;
		border-bottom-color: var(--accent);
	}

	.err {
		min-height: 1.2em;
		font-family: var(--font-cjk);
		font-size: 0.78rem;
		letter-spacing: 0.1em;
		color: var(--orange-dim);
	}

	.act {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block-start: 0.75rem;
		border-top: var(--hairline) solid var(--rule);
	}

	.send {
		min-height: 2.75rem;
		padding-inline: 0.1rem;
		font-family: var(--font-cjk);
		font-weight: 700;
		font-size: clamp(1.25rem, 4vw, 1.75rem);
		letter-spacing: 0.04em;
		color: var(--accent-txt);
	}

	.send:hover,
	.send:focus-visible {
		color: var(--orange-deep);
	}

	.mail {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.18em;
		color: var(--dim);
	}

	@media (min-width: 42rem) {
		.fields {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: clamp(1.5rem, 4vw, 3rem);
		}

		.f-wide {
			grid-column: 1 / -1;
		}
	}
</style>
