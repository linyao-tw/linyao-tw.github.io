---
import { cta } from "../../lib/copy";
---

<section class="cta" id="contact" aria-labelledby="d02-cta-h">
	<div class="ghost" aria-hidden="true">實</div>

	<h2 class="h" id="d02-cta-h" aria-label={cta.headline} data-d02-lines>
		<span class="ln a"><span class="d02-li">{cta.headlineParts[0]}</span></span>
		<span class="ln b"><span class="d02-li">{cta.headlineParts[1]}</span></span>
	</h2>

	<div class="under">
		<p class="body" lang="zh-Hant">
			{cta.body.map(line => <span class="bl">{line}</span>)}
		</p>

		<button class="ask" type="button" data-d02-inquiry>
			<span class="ask-t">{cta.button}</span>
			<span class="ask-r" aria-hidden="true"></span>
		</button>
	</div>
</section>

<style>
	.cta {
		position: relative;
		overflow: clip;
		display: grid;
		gap: clamp(2rem, 6vh, 3.5rem);
		padding: clamp(4.5rem, 14vh, 9rem) var(--edge) clamp(4rem, 11vh, 7rem);
		border-top: var(--hairline) solid var(--rule);
	}

	.ghost {
		position: absolute;
		inset-block-end: -22vw;
		inset-inline-end: -6vw;
		font-family: var(--font-cjk);
		font-weight: 700;
		font-size: 58vw;
		line-height: 0.78;
		color: var(--ghost);
		user-select: none;
		pointer-events: none;
	}

	.h {
		position: relative;
		z-index: 1;
		display: grid;
		font-family: var(--font-cjk);
		font-weight: 700;
		color: var(--ink);
	}

	.ln {
		display: block;
		overflow: clip;
		padding-block: 0.1em;
		margin-block: -0.1em;
	}

	.ln .d02-li {
		display: block;
		line-height: 0.86;
		white-space: nowrap;
		will-change: transform;
	}

	.a .d02-li {
		font-size: clamp(2rem, 7.4vw, 6rem);
		letter-spacing: 0.06em;
		color: var(--dim);
	}

	.b {
		margin-block-start: 0.3rem;
	}

	.b .d02-li {
		font-size: clamp(2.6rem, 11.6vw, 9.5rem);
		letter-spacing: -0.03em;
		margin-inline-start: -0.05em;
	}

	.under {
		position: relative;
		z-index: 1;
		display: grid;
		gap: clamp(2rem, 6vh, 3.5rem);
	}

	.body {
		display: grid;
		gap: 0.1rem;
		max-width: 24rem;
		font-family: var(--font-cjk);
		font-size: clamp(0.82rem, 1.05vw, 0.95rem);
		line-height: 2.05;
		letter-spacing: 0.08em;
		color: var(--quiet);
	}

	.bl {
		display: block;
	}

	/* --- the ask ------------------------------------------------------- */
	.ask {
		display: grid;
		gap: 0.6rem;
		justify-self: start;
		max-width: 100%;
		min-height: 2.75rem;
		text-align: start;
	}

	.ask-t {
		font-family: var(--font-cjk);
		font-weight: 700;
		font-size: clamp(2.5rem, 12.5vw, 10rem);
		line-height: 0.9;
		letter-spacing: 0.02em;
		color: transparent;
		-webkit-text-stroke: 0.014em var(--accent);
		transition: color 0.4s ease;
	}

	.ask-r {
		display: block;
		height: 0.14rem;
		background: var(--accent);
		transform: scaleX(0.16);
		transform-origin: left center;
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.ask:hover .ask-t,
	.ask:focus-visible .ask-t {
		color: var(--accent);
	}

	.ask:hover .ask-r,
	.ask:focus-visible .ask-r {
		transform: scaleX(1);
	}

	@media (min-width: 62rem) {
		.under {
			grid-template-columns: minmax(0, 1fr);
		}

		.body {
			justify-self: end;
			text-align: end;
			justify-items: end;
		}
	}
</style>
