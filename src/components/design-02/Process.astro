---
import { process } from "../../lib/copy";
---

<section class="proc d02-proc" id="process" aria-labelledby="d02-proc-h">
	<div class="ghost" aria-hidden="true">創</div>

	<div class="top">
		<h2 class="h" id="d02-proc-h" aria-label={`${process.headlineParts[0]}${process.headlineParts[1]}`} data-d02-lines>
			<span class="ln a"><span class="d02-li">{process.headlineParts[0]}</span></span>
			<span class="ln b"><span class="d02-li">{process.headlineParts[1]}</span></span>
		</h2>
		<p class="hw" aria-hidden="true">{process.kicker}</p>
	</div>

	<div class="clip">
		<ol class="strip d02-strip">
			{
				process.steps.map(s => (
					<li class="step">
						<h3 class="sh" aria-label={`${s.index} ${s.en}`}>
							<span class="n">{s.index}</span>
							<span class="en">{s.en}</span>
						</h3>
						<p class="zh" lang="zh-Hant">
							{s.zh}
						</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.proc {
		position: relative;
		overflow: clip;
		padding-block: clamp(4rem, 12vh, 8rem) clamp(3rem, 9vh, 6rem);
		border-top: var(--hairline) solid var(--rule);
	}

	.ghost {
		position: absolute;
		inset-block-start: -8vw;
		inset-inline-start: -10vw;
		font-family: var(--font-cjk);
		font-weight: 700;
		font-size: 48vw;
		line-height: 0.78;
		color: transparent;
		-webkit-text-stroke: 1px var(--ghost-line);
		user-select: none;
		pointer-events: none;
	}

	.top {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		padding-inline: var(--edge);
		padding-block-end: clamp(2rem, 7vh, 4rem);
	}

	.h {
		display: grid;
		font-family: var(--font-cjk);
		font-weight: 700;
		color: var(--ink);
	}

	.ln {
		display: block;
		overflow: clip;
		/* Noto Sans TC's font box is 1.45em (asc 1.160 + desc 0.290) and its ink
		   sits low in it, so at these line-heights the glyph overflows the line
		   box by up to 0.148em below. Pad the clip box past that and cancel the
		   padding with an equal negative margin so layout is unchanged. */
		padding-block: 0.16em;
		margin-block: -0.16em;
	}

	.ln .d02-li {
		display: block;
		line-height: 0.88;
		white-space: nowrap;
		will-change: transform;
	}

	.a {
		font-size: clamp(1.4rem, 4.6vw, 3.5rem);
	}

	.a .d02-li {
		letter-spacing: 0.14em;
		color: var(--dim);
	}

	.b {
		font-size: clamp(2.6rem, 11vw, 8.5rem);
	}

	.b .d02-li {
		letter-spacing: -0.02em;
		margin-inline-start: -0.04em;
	}

	.hw {
		writing-mode: vertical-rl;
		font-family: var(--font-mono);
		font-size: 0.58rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--accent-txt);
		flex: none;
	}

	/* --- the horizontal type sequence --------------------------------- */
	.clip {
		position: relative;
		z-index: 1;
		overflow: clip;
		border-top: var(--hairline) solid var(--rule);
	}

	.strip {
		--st: clamp(0.95rem, 2.2vw, 1.6rem);
		--sn: clamp(1.75rem, 4vw, 3rem);
		display: grid;
		width: 100%;
		will-change: transform;
	}

	.step {
		display: grid;
		align-content: start;
		gap: 0.5rem;
		padding: clamp(1.25rem, 3.5vh, 2.5rem) clamp(0.75rem, 2vw, 2rem);
		border-inline-start: var(--hairline) solid var(--rule-soft);
	}

	.step:first-child {
		border-inline-start: 0;
		padding-inline-start: var(--edge);
	}

	.sh {
		display: grid;
		gap: 0.2rem;
	}

	.n {
		font-family: var(--font-grotesk);
		font-weight: 800;
		font-size: var(--sn);
		line-height: 0.8;
		letter-spacing: -0.05em;
		color: transparent;
		-webkit-text-stroke: 1px var(--ink);
	}

	.step:nth-child(odd) .n {
		color: var(--accent);
		-webkit-text-stroke-width: 0;
	}

	.en {
		font-family: var(--font-grotesk);
		font-weight: 700;
		font-size: var(--st);
		line-height: 0.92;
		letter-spacing: -0.02em;
		color: var(--ink);
		white-space: nowrap;
	}

	.zh {
		font-family: var(--font-cjk);
		font-size: clamp(0.72rem, 0.95vw, 0.84rem);
		letter-spacing: 0.14em;
		color: var(--quiet);
		white-space: nowrap;
	}

	@media (max-width: 47.99rem) {
		.strip {
			--st: clamp(1.6rem, 8.5vw, 2.6rem);
			--sn: clamp(2.25rem, 13vw, 4rem);
			grid-template-columns: 1fr;
		}

		.step {
			grid-template-columns: auto 1fr;
			align-items: baseline;
			gap: 0.4rem 1rem;
			padding-inline: var(--edge);
			border-inline-start: 0;
			border-block-end: var(--hairline) solid var(--rule-soft);
		}

		.sh {
			grid-column: 1 / -1;
			grid-template-columns: auto auto;
			align-items: baseline;
			gap: 0.75rem;
			justify-content: start;
		}
	}

	@media (min-width: 48rem) {
		.strip {
			grid-template-columns: repeat(5, minmax(0, 1fr));
		}
	}

	:global(body.d02-js) .strip {
		--st: clamp(1.7rem, 4.6vw, 4.25rem);
		--sn: clamp(3rem, 8vw, 7rem);
	}

	@media (min-width: 48rem) {
		:global(body.d02-js) .strip {
			width: 190%;
		}
	}

	@media (max-width: 47.99rem) {
		:global(body.d02-js) .strip {
			--st: clamp(1.6rem, 8.5vw, 2.6rem);
			--sn: clamp(2.25rem, 13vw, 4rem);
		}
	}
</style>
