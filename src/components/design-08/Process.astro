---
import { process } from "../../lib/copy";
---

<section class="proc" id="process" aria-labelledby="d08-proc-h">
	<div class="in d08-shell">
		<p class="d08-head">
			<span class="d08-coord">[05.00]</span>
			<b>HOW WE WORK — LINEAR ROUTE</b>
			<i aria-hidden="true"></i>
			<span>5 NODES / 1 PASS</span>
		</p>

		<h2 id="d08-proc-h" class="hl">
			<span class="w">{process.headlineParts[0]}</span>
			<span class="arrow" aria-hidden="true"></span>
			<span class="w w-hi">{process.headlineParts[1]}</span>
		</h2>

		<div class="route">
			<span class="rail" aria-hidden="true"></span>
			<ol class="steps">
				{
					process.steps.map(s => (
						<li>
							<span class="node d08-node" aria-hidden="true" />
							<span class="riser" aria-hidden="true" />
							<span class="ix">{s.index}</span> <span class="en">{s.en}</span>
							<span class="zh">{s.zh}</span>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>

<style>
	.proc {
		padding-block: clamp(3.5rem, 9vw, 8rem) clamp(4rem, 10vw, 9rem);
		overflow: clip;
	}

	.hl {
		display: flex;
		align-items: center;
		gap: clamp(0.75rem, 2.4vw, 2rem);
		font-family: var(--font-cjk);
		font-weight: 600;
		font-size: clamp(1.75rem, 5vw, 4.25rem);
		line-height: 1.05;
		letter-spacing: 0.04em;
		padding-block: clamp(1.75rem, 4.5vw, 3.5rem) clamp(2.5rem, 6vw, 5rem);
	}

	.w-hi {
		color: var(--accent);
	}

	.arrow {
		flex: 1 1 auto;
		min-width: 2rem;
		max-width: 22rem;
		height: 1px;
		background: var(--fg);
		position: relative;
		transform-origin: left center;
	}

	.arrow::after {
		content: "";
		position: absolute;
		right: 0;
		top: 50%;
		width: 0.5rem;
		height: 0.5rem;
		margin-top: -0.25rem;
		background: var(--accent);
	}

	.route {
		position: relative;
	}

	.rail {
		position: absolute;
		top: 0.375rem;
		left: 0;
		right: 0;
		height: 1px;
		background: var(--fg);
		transform-origin: left center;
	}

	.rail::after {
		content: "▶";
		position: absolute;
		right: -0.15rem;
		top: 50%;
		transform: translateY(-50%);
		font-size: 0.75rem;
		line-height: 1;
		color: var(--accent);
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
	}

	.steps li {
		position: relative;
		padding: 2.6rem 1.5rem 0 0;
		display: grid;
		gap: 0.3rem;
		align-content: start;
	}

	.node {
		position: absolute;
		top: 0;
		left: 0;
		width: 0.75rem;
		height: 0.75rem;
		background: var(--paper-hi);
		border: 1px solid var(--fg);
	}

	.steps li:first-child .node {
		background: var(--ink-deep);
		border-color: var(--ink-deep);
	}

	.steps li:last-child .node {
		background: var(--accent);
		border-color: var(--accent);
	}

	.riser {
		position: absolute;
		top: 0.75rem;
		left: 0.375rem;
		width: 1px;
		height: 1.35rem;
		background: var(--rule);
	}

	.ix {
		font-size: clamp(1.75rem, 3.4vw, 3rem);
		line-height: 0.9;
		letter-spacing: -0.02em;
		color: var(--accent);
		font-variant-numeric: tabular-nums;
	}

	.en {
		font-size: clamp(0.8125rem, 1.3vw, 1.0625rem);
		letter-spacing: 0.12em;
		margin-top: 0.35rem;
	}

	.zh {
		font-family: var(--font-cjk);
		font-size: 0.8125rem;
		line-height: 1.75;
		letter-spacing: 0.06em;
		color: var(--dim);
	}

	@media (max-width: 68rem) {
		.steps {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			row-gap: var(--s-8);
		}

		.rail {
			display: none;
		}

		.steps li {
			border-top: 1px solid var(--fg);
			padding-top: 1.6rem;
		}

		.node {
			top: -0.375rem;
		}

		.riser {
			top: 0.4rem;
			height: 1rem;
		}
	}

	@media (max-width: 48rem) {
		.hl {
			display: grid;
			justify-items: start;
			gap: 0.9rem;
		}

		.arrow {
			width: 60%;
			max-width: none;
		}

		.steps {
			grid-template-columns: minmax(0, 1fr);
			row-gap: var(--s-6);
		}

		.steps li {
			padding-right: 0;
			grid-template-columns: 5ch 1fr;
			column-gap: 1.5ch;
			align-items: baseline;
		}

		.ix {
			grid-row: 1 / 3;
		}

		.en {
			margin-top: 0;
		}
	}
</style>

<script>
	import { motion } from "../../lib/motion";

	motion(({ gsap }) => {
		gsap.from(".proc .arrow", {
			scaleX: 0,
			duration: 0.6,
			ease: "power2.inOut",
			scrollTrigger: { trigger: ".proc .hl", start: "top 82%" }
		});

		const tl = gsap.timeline({ scrollTrigger: { trigger: ".proc .route", start: "top 80%" } });

		tl.from(".proc .rail", { scaleX: 0, duration: 0.85, ease: "power2.inOut" })
			.from(".proc .node", { scale: 0, duration: 0.22, stagger: 0.1, ease: "power1.out" }, "-=0.7")
			.from(".proc .riser", { scaleY: 0, transformOrigin: "top center", duration: 0.18, stagger: 0.1 }, "-=0.75")
			.from(".proc .ix, .proc .en, .proc .zh", { opacity: 0, y: 10, duration: 0.3, stagger: 0.03 }, "-=0.8");
	});
</script>
