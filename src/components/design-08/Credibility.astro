---
import { manifesto } from "../../lib/copy";
---

<section class="cred d08-band" aria-labelledby="d08-cred-h">
	<div class="in d08-shell">
		<p class="d08-head">
			<span class="d08-coord">[04.01]</span>
			<b>MEASURED VALUES</b>
			<i aria-hidden="true"></i>
			<span>3 FIGURES / VERIFIED</span>
		</p>
		<h2 id="d08-cred-h" class="visually-hidden">工作室紀錄</h2>

		<dl class="vals">
			{
				manifesto.credibility.map((c, i) => (
					<div class="val">
						<dt>
							<span class="ref d08-coord">[04.01.{i + 1}]</span>
							<span class="fig">{c.figure}</span>
						</dt>
						<dd>
							<span class="dimline" aria-hidden="true">
								<i class="cap" />
								<i class="bar" />
								<i class="cap" />
							</span>
							<span class="en">{c.en}</span>
							<span class="zh">{c.label}</span>
						</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.cred {
		padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3rem, 7vw, 5.5rem);
		border-block: 1px solid var(--rule);
		overflow: clip;
	}

	.vals {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--mod);
		padding-top: clamp(2rem, 5vw, 4rem);
		align-items: end;
	}

	.val {
		display: grid;
		gap: 0.9rem;
	}

	.val:nth-child(2) {
		padding-top: clamp(1rem, 3vw, 3rem);
	}

	.val:nth-child(3) {
		padding-top: clamp(2rem, 6vw, 6rem);
	}

	dt {
		display: grid;
		gap: 0.5rem;
	}

	.ref {
		font-size: 0.625rem;
		letter-spacing: 0.16em;
	}

	.fig {
		display: block;
		font-size: clamp(2.5rem, 6.4vw, 6.5rem);
		line-height: 0.86;
		letter-spacing: -0.03em;
		color: var(--fg);
		font-variant-numeric: tabular-nums;
		word-break: break-word;
	}

	.val:nth-child(1) .fig {
		color: var(--accent);
	}

	.val:nth-child(3) .fig {
		font-size: clamp(1.75rem, 4.2vw, 4rem);
		letter-spacing: -0.02em;
	}

	dd {
		display: grid;
		gap: 0.55rem;
	}

	.dimline {
		display: flex;
		align-items: center;
		width: 100%;
		transform-origin: left center;
	}

	.cap {
		flex: none;
		width: 1px;
		height: 0.5rem;
		background: var(--fg);
	}

	.bar {
		flex: 1;
		height: 1px;
		background: var(--fg);
	}

	.en {
		font-size: 0.6875rem;
		letter-spacing: 0.2em;
		color: var(--dim);
	}

	.zh {
		font-family: var(--font-cjk);
		font-size: clamp(0.8125rem, 1vw, 0.9375rem);
		line-height: 1.7;
		letter-spacing: 0.06em;
		color: var(--fg);
	}

	@media (max-width: 68rem) {
		.vals {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--s-8) var(--mod);
		}

		.val:nth-child(3) {
			grid-column: 1 / -1;
			padding-top: 0;
		}
	}

	@media (max-width: 48rem) {
		.vals {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--s-8);
		}

		.val:nth-child(2),
		.val:nth-child(3) {
			padding-top: 0;
		}

		.val + .val {
			border-top: 1px solid var(--rule-soft);
			padding-top: var(--s-6);
		}
	}
</style>

<script>
	import { motion } from "../../lib/motion";

	motion(({ gsap }) => {
		gsap.from(".cred .fig", {
			opacity: 0,
			y: 18,
			duration: 0.5,
			stagger: 0.1,
			ease: "power2.out",
			scrollTrigger: { trigger: ".cred .vals", start: "top 82%" }
		});

		gsap.from(".cred .dimline", {
			scaleX: 0,
			duration: 0.55,
			stagger: 0.1,
			ease: "power2.inOut",
			scrollTrigger: { trigger: ".cred .vals", start: "top 82%" }
		});
	});
</script>
