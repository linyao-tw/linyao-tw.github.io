---
import { services } from "../../lib/copy";

const topo = ["SERIAL COMB", "CLOSED LOOP", "BRANCH TREE"];
const cells = Array.from({ length: 48 }, (_, i) => i);
---

<section class="idx d08-band" id="services" aria-labelledby="d08-idx-h">
	<div class="cellfield" aria-hidden="true">
		{cells.map(i => <span class="d08-cell" style={`--i:${i}`} />)}
	</div>

	<div class="in d08-shell">
		<p class="d08-head">
			<span class="d08-coord">[03.00]</span>
			<b>SERVICE INDEX</b>
			<i aria-hidden="true"></i>
			<span>3 MODULES / 18 LEAF</span>
		</p>

		<div class="top">
			<h2 id="d08-idx-h">{services.lead}</h2>
			<p class="note">⟦ EACH MODULE IS DRAWN AS ITS OWN TOPOLOGY ⟧</p>
		</div>

		<ol class="rows">
			{
				services.items.map((s, i) => (
					<li>
						<a href={`#svc-${s.index}`}>
							<span class="c d08-coord">[03.0{i + 1}]</span>
							<span class="c num">{s.index}</span>
							<span class="c en">{s.en}</span>
							<span class="c zh">{s.zh}</span>
							<span class="c pos">{s.position}</span>
							<span class="c tp">{topo[i]}</span>
							<span class="c go" aria-hidden="true">
								↓
							</span>
						</a>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.idx {
		padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3rem, 7vw, 5.5rem);
		border-block: 1px solid var(--rule);
		overflow: clip;
	}

	.cellfield {
		position: absolute;
		inset: 0;
		z-index: -1;
		display: grid;
		grid-template-columns: repeat(auto-fill, var(--mod));
		grid-auto-rows: var(--mod);
		pointer-events: none;
	}

	.d08-cell {
		background: color-mix(in oklab, var(--graphite) 6%, transparent);
		opacity: 0;
	}

	.d08-cell:nth-child(9n + 4) {
		opacity: 1;
	}

	.d08-cell:nth-child(23n + 7) {
		opacity: 1;
		background: color-mix(in oklab, var(--orange) 7%, transparent);
	}

	.top {
		display: grid;
		grid-template-columns: minmax(0, 1fr) max-content;
		align-items: end;
		gap: var(--s-6);
		padding-block: clamp(1.5rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
	}

	.top h2 {
		font-family: var(--font-cjk);
		font-size: clamp(1.0625rem, 1.9vw, 1.625rem);
		line-height: 1.6;
		letter-spacing: 0.03em;
		max-width: 34ch;
	}

	.note {
		font-size: 0.6875rem;
		letter-spacing: 0.16em;
		color: var(--dim);
		white-space: nowrap;
	}

	.rows {
		border-top: 1px solid var(--fg);
	}

	.rows li {
		border-bottom: 1px solid var(--rule-soft);
	}

	.rows a {
		display: grid;
		grid-template-columns: 8ch 4ch minmax(0, 26ch) minmax(0, 9ch) minmax(0, 1fr) minmax(0, 13ch) 3ch;
		align-items: center;
		gap: 1.5ch;
		min-height: 3.25rem;
		transition:
			background-color 0.14s linear,
			color 0.14s linear;
	}

	.rows a:hover,
	.rows a:focus-visible {
		background: color-mix(in oklab, var(--graphite) 8%, transparent);
	}

	.c {
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		color: var(--dim);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.num {
		font-size: 1.125rem;
		color: var(--fg);
	}

	.en {
		font-size: clamp(0.875rem, 1.4vw, 1.125rem);
		letter-spacing: 0.06em;
		color: var(--fg);
	}

	.zh {
		font-family: var(--font-cjk);
		font-size: 0.9375rem;
		letter-spacing: 0.1em;
		color: var(--fg);
	}

	.pos {
		font-family: var(--font-cjk);
		letter-spacing: 0.05em;
	}

	.tp {
		text-align: right;
	}

	.go {
		text-align: right;
		color: var(--accent);
		font-size: 0.875rem;
	}

	.rows a:hover .go,
	.rows a:focus-visible .go {
		transform: translateY(0.15rem);
	}

	@media (max-width: 72rem) {
		.rows a {
			grid-template-columns: 7ch 3ch minmax(0, 1fr) minmax(0, 9ch) 3ch;
		}

		.pos,
		.tp {
			display: none;
		}
	}

	@media (max-width: 48rem) {
		.top {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.note {
			white-space: normal;
		}

		.rows a {
			grid-template-columns: 6ch 1fr 3ch;
			grid-template-rows: auto auto;
			row-gap: 0.15rem;
			padding-block: 0.85rem;
			align-items: baseline;
		}

		.num {
			display: none;
		}

		.en {
			grid-column: 2;
		}

		.zh {
			grid-column: 2;
		}

		.go {
			grid-row: 1 / 3;
			grid-column: 3;
		}
	}
</style>

<script>
	import { motion } from "../../lib/motion";

	motion(({ gsap }) => {
		gsap.from(".idx .d08-cell", {
			scale: 0,
			opacity: 0,
			transformOrigin: "0% 0%",
			duration: 0.3,
			ease: "none",
			stagger: { each: 0.012, from: "start" },
			scrollTrigger: { trigger: ".idx", start: "top 88%" }
		});

		gsap.from(".idx .rows li", {
			opacity: 0,
			x: -14,
			duration: 0.38,
			stagger: 0.09,
			ease: "power1.out",
			scrollTrigger: { trigger: ".idx .rows", start: "top 86%" }
		});
	});
</script>
