---
import { brand } from "../../lib/copy";
import { sections } from "./sections";
---

<footer class="ft inv">
	<div class="ft__g g12">
		<div class="ft__mark">
			<p class="ft__en">{brand.nameEn}</p>
			<p class="ft__zh">{brand.nameZh}</p>
			<p class="ft__eq note">{brand.equation}</p>
		</div>

		<nav class="ft__nav" id="ft-index" aria-label="頁尾章節索引">
			<ol>
				{
					sections.map(s => (
						<li>
							<a href={`#${s.id}`} data-idx-item={s.id}>
								<span>{s.n}</span>
								{s.en}
							</a>
						</li>
					))
				}
			</ol>
		</nav>

		<div class="ft__reach">
			<a class="ft__mail" href={`mailto:${brand.email}`}>{brand.email}</a>
			<p class="ft__disc">{brand.disciplines}</p>
		</div>

		<p class="ft__cr note">{brand.copyright}</p>
		<p class="ft__idx note" aria-hidden="true">09 MOVEMENTS / 12 COLUMNS / 03 COLOURS</p>
	</div>
</footer>

<style>
	.ft {
		position: relative;
		padding-block: clamp(3rem, 7vw, 6rem) clamp(2rem, 4vw, 3.5rem);
		border-top: 0.4375rem solid var(--d10-accent);
	}

	.ft__g {
		row-gap: clamp(2rem, 5vw, 3.5rem);
		align-items: start;
	}

	.ft__mark {
		grid-column: 1 / 6;
		display: grid;
		gap: 0.375rem;
	}

	.ft__en {
		font-family: var(--font-grotesk);
		font-weight: 700;
		font-size: clamp(1.375rem, 3.6vw, 2.75rem);
		line-height: 0.95;
		letter-spacing: -0.035em;
		color: var(--d10-paper-hi);
	}

	.ft__zh {
		font-family: var(--font-cjk);
		font-size: clamp(0.875rem, 1.4vw, 1.0625rem);
		letter-spacing: 0.34em;
		color: var(--d10-paper);
	}

	.ft__eq {
		color: var(--d10-accent);
		letter-spacing: 0.28em;
		margin-top: 0.5rem;
	}

	.ft__nav {
		grid-column: 7 / 10;
	}

	.ft__nav ol {
		display: grid;
		gap: 0.125rem;
	}

	.ft__nav a {
		display: flex;
		align-items: baseline;
		gap: 0.625rem;
		min-height: 1.75rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.16em;
		color: color-mix(in oklab, var(--d10-paper) 66%, transparent);
	}

	.ft__nav a span {
		color: var(--d10-accent);
	}

	.ft__nav a:hover,
	.ft__nav a:focus-visible {
		color: var(--d10-paper-hi);
	}

	.ft__nav a[aria-current="true"] {
		color: var(--d10-accent);
	}

	.ft__reach {
		grid-column: 10 / 13;
		display: grid;
		gap: 0.75rem;
		justify-items: start;
	}

	.ft__mail {
		font-family: var(--font-mono);
		font-size: clamp(0.8125rem, 1.2vw, 1rem);
		letter-spacing: 0.1em;
		color: var(--d10-paper-hi);
		border-bottom: 0.125rem solid var(--d10-accent);
		padding-bottom: 0.25rem;
		min-height: 2.75rem;
		display: inline-flex;
		align-items: center;
	}

	.ft__disc {
		font-family: var(--font-cjk);
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		color: color-mix(in oklab, var(--d10-paper) 72%, transparent);
	}

	.ft__cr {
		grid-column: 1 / 7;
		color: color-mix(in oklab, var(--d10-paper) 68%, transparent);
		border-top: var(--hairline) solid var(--d10-rule);
		padding-top: 0.75rem;
	}

	.ft__idx {
		grid-column: 7 / 13;
		text-align: right;
		color: color-mix(in oklab, var(--d10-paper) 68%, transparent);
		border-top: var(--hairline) solid var(--d10-rule);
		padding-top: 0.75rem;
	}

	@media (max-width: 63.99em) {
		.ft__mark,
		.ft__nav,
		.ft__reach,
		.ft__cr,
		.ft__idx {
			grid-column: 1 / 13;
		}

		.ft__nav ol {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.ft__idx {
			text-align: left;
		}
	}
</style>
