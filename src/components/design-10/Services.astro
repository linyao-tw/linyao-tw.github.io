---
import { capabilities, services } from "../../lib/copy";

const targets = ["web", "system", "creative"];
const rowA = [...capabilities];
const rowB = [...capabilities].reverse();
---

{
	/* The capability band lands here — early, cutting the intro off mid-breath,
    long before anyone expects a marquee. */
}
<div class="mq inv" role="group" aria-label="能力範圍 CAPABILITIES">
	<div class="mq__row">
		<div class="mq__track">
			<ul class="mq__set">
				{
					rowA.map(c => (
						<li>
							<i aria-hidden="true" />
							{c}
						</li>
					))
				}
			</ul>
			<ul class="mq__set" aria-hidden="true">
				{
					rowA.map(c => (
						<li>
							<i />
							{c}
						</li>
					))
				}
			</ul>
		</div>
	</div>
	<div class="mq__row mq__row--rev" aria-hidden="true">
		<div class="mq__track">
			<ul class="mq__set">
				{
					rowB.map(c => (
						<li>
							<i />
							{c}
						</li>
					))
				}
			</ul>
			<ul class="mq__set">
				{
					rowB.map(c => (
						<li>
							<i />
							{c}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</div>

<section id="services" class="sv" aria-labelledby="sv-h" data-d10-section>
	<div class="sv__g g12">
		<p class="sv__run note" aria-hidden="true">03 / SERVICES</p>

		<h2 id="sv-h" class="sv__h" data-reveal>{services.lead}</h2>

		<ol class="sv__list">
			{
				services.items.map((s, i) => (
					<li>
						<a href={`#${targets[i]}`}>
							<span class="sv__n">{s.index}</span>
							<span class="sv__en">{s.en}</span>
							<span class="sv__pos">{s.position}</span>
							<span class="sv__go" aria-hidden="true">
								↓
							</span>
						</a>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	/* ------------------------------ marquee ------------------------------ */
	.mq {
		overflow: clip;
		padding-block: 0.875rem;
		border-block: var(--hairline) solid color-mix(in oklab, var(--d10-paper) 24%, transparent);
	}

	.mq__row {
		overflow: clip;
	}

	.mq__row + .mq__row {
		margin-top: 0.375rem;
		opacity: 0.5;
	}

	.mq__track {
		display: flex;
		width: max-content;
		animation: d10-mq 46s linear infinite;
	}

	.mq__row--rev .mq__track {
		animation-direction: reverse;
		animation-duration: 62s;
	}

	.mq__set {
		display: flex;
		align-items: center;
	}

	.mq__set li {
		display: flex;
		align-items: center;
		gap: clamp(1.25rem, 3vw, 2.75rem);
		padding-right: clamp(1.25rem, 3vw, 2.75rem);
		font-family: var(--font-grotesk);
		font-weight: 700;
		font-size: clamp(1.125rem, 3.4vw, 2.25rem);
		letter-spacing: -0.015em;
		white-space: nowrap;
		color: var(--d10-paper);
	}

	.mq__set i {
		display: block;
		width: 0.4375rem;
		height: 0.4375rem;
		background: var(--d10-accent);
		flex: none;
	}

	.mq__row--rev .mq__set li {
		font-weight: 400;
		font-family: var(--font-mono);
		font-size: clamp(0.6875rem, 1.6vw, 1rem);
		letter-spacing: 0.24em;
	}

	@keyframes d10-mq {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	/* ------------------------------ statement ---------------------------- */
	.sv {
		position: relative;
		padding-block: clamp(3.5rem, 8vw, 7rem);
	}

	.sv__g {
		row-gap: clamp(2rem, 4vw, 3.5rem);
		align-items: start;
	}

	.sv__run {
		grid-column: 1 / 3;
		color: var(--d10-mark);
		border-top: 0.1875rem solid var(--d10-accent);
		padding-top: 0.5rem;
	}

	.sv__h {
		grid-column: 3 / 10;
		font-family: var(--font-cjk);
		font-size: clamp(1.25rem, 2.9vw, 2.5rem);
		font-weight: 700;
		line-height: 1.5;
		letter-spacing: 0.01em;
		text-wrap: balance;
	}

	.sv__list {
		grid-column: 3 / 13;
		border-top: var(--hairline) solid var(--d10-rule);
	}

	.sv__list a {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr) 2rem;
		align-items: baseline;
		gap: 0.25rem 1rem;
		padding-block: 0.9375rem;
		min-height: 2.75rem;
		border-bottom: var(--hairline) solid var(--d10-rule);
		transition: background 0.22s ease;
	}

	.sv__list a:hover,
	.sv__list a:focus-visible {
		background: color-mix(in oklab, var(--d10-accent) 14%, transparent);
	}

	.sv__n {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.8125rem;
		letter-spacing: 0.08em;
		color: var(--d10-mark);
	}

	.sv__en {
		font-family: var(--font-grotesk);
		font-weight: 700;
		font-size: clamp(1.0625rem, 2.4vw, 1.75rem);
		letter-spacing: -0.02em;
	}

	.sv__pos {
		grid-column: 2;
		font-family: var(--font-cjk);
		font-size: 0.8125rem;
		letter-spacing: 0.08em;
		color: var(--d10-quiet);
	}

	.sv__go {
		grid-row: 1 / 3;
		grid-column: 3;
		justify-self: end;
		align-self: center;
		color: var(--d10-accent);
		font-size: 1rem;
	}

	@media (min-width: 64em) {
		.sv__list a {
			grid-template-columns: 4.5rem minmax(0, 22rem) minmax(0, 1fr) 2rem;
		}

		.sv__pos {
			grid-column: 3;
			align-self: baseline;
			font-size: 0.875rem;
		}

		.sv__go {
			grid-row: 1;
			grid-column: 4;
		}
	}

	@media (max-width: 63.99em) {
		.sv__run {
			grid-column: 1 / 6;
		}

		.sv__h {
			grid-column: 1 / 13;
		}

		.sv__list {
			grid-column: 1 / 13;
		}
	}
</style>
