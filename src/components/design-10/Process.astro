---
import { process } from "../../lib/copy";
---

{
	/* MOVEMENT 08 — the signature. The near-black composition of the manifesto
    is carried into this section as a veil and then wiped off the screen in a
    single continuous clip-path move, uncovering the process on paper beneath.
    Without JS the veil is already retracted, so nothing is ever hidden. */
}
<section id="process" class="pr" aria-labelledby="pr-h" data-d10-section>
	<div class="pr__stage" data-wipe-stage>
		<div class="pr__sticky" data-wipe-sticky>
			<div class="pr__head g12">
				<p class="pr__running" aria-hidden="true">{process.kicker}</p>

				<h2 id="pr-h" class="pr__h" aria-label={`${process.headlineParts[0]}${process.headlineParts[1]}`} data-wipe-head>
					<span aria-hidden="true">{process.headlineParts[0]}</span>
					<span class="pr__h2" aria-hidden="true">{process.headlineParts[1]}</span>
				</h2>

				<p class="pr__readout note" aria-hidden="true" data-proc-readout>STEP 01 / 05</p>
			</div>

			<div class="pr__veil" aria-hidden="true">
				<span class="pr__veilType">體驗</span>
			</div>
			<span class="pr__edge" aria-hidden="true"></span>
		</div>
	</div>

	<ol class="pr__steps g12">
		{
			process.steps.map(step => (
				<li class="pr__step" data-step={step.index}>
					<span class="pr__n" aria-hidden="true">
						{step.index}
					</span>
					<h3 class="pr__en" aria-label={`${step.index} ${step.en}`}>
						<span aria-hidden="true">{step.en}</span>
					</h3>
					<p class="pr__zh">{step.zh}</p>
					<span class="pr__rule" aria-hidden="true" />
				</li>
			))
		}
	</ol>
</section>

<style>
	.pr {
		position: relative;
		background: var(--d10-paper);
	}

	.pr__stage {
		position: relative;
		height: 185svh;
	}

	.pr__sticky {
		position: sticky;
		top: 0;
		height: 100svh;
		overflow: clip;
		display: grid;
		align-content: center;
		/* default = veil fully retracted. JS drives it from 0 to 100vh. */
		--wipe: 100svh;
	}

	.pr__head {
		position: relative;
		z-index: 1;
		align-content: center;
		row-gap: clamp(1rem, 2.5vw, 2rem);
	}

	.pr__running {
		grid-column: 1 / 2;
		writing-mode: vertical-rl;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.34em;
		text-transform: uppercase;
		color: var(--d10-mark);
		border-left: 0.1875rem solid var(--d10-accent);
		padding-left: 0.5rem;
		align-self: start;
		grid-row: 1 / 3;
	}

	.pr__h {
		grid-column: 3 / 13;
		grid-row: 1;
		font-family: var(--font-cjk);
		font-weight: 700;
		font-size: clamp(3rem, 15vw, 12rem);
		line-height: 0.95;
		letter-spacing: -0.04em;
		color: var(--d10-ink);
	}

	.pr__h span {
		display: block;
	}

	.pr__h2 {
		margin-left: 12%;
		color: var(--d10-accent);
	}

	.pr__readout {
		grid-column: 3 / 13;
		grid-row: 2;
		color: var(--d10-quiet);
		border-top: var(--hairline) solid var(--d10-rule);
		padding-top: 0.625rem;
	}

	/* --- the veil ----------------------------------------------------- */
	.pr__veil {
		position: absolute;
		inset: 0;
		z-index: 3;
		background: var(--d10-void);
		clip-path: inset(0 0 var(--wipe) 0);
		display: grid;
		place-content: center end;
		padding-right: var(--d10-gr);
		pointer-events: none;
	}

	.pr__veilType {
		font-family: var(--font-cjk);
		font-weight: 700;
		font-size: clamp(7rem, 40vw, 26rem);
		line-height: 0.8;
		letter-spacing: -0.04em;
		color: transparent;
		-webkit-text-stroke: 1px color-mix(in oklab, var(--paper-hi) 34%, transparent);
		transform: translateY(calc(var(--wipe) * -0.14));
	}

	.pr__edge {
		position: absolute;
		z-index: 4;
		left: 0;
		right: 0;
		bottom: 0;
		height: 0.4375rem;
		background: var(--d10-accent);
		transform: translateY(calc(var(--wipe) * -1));
		pointer-events: none;
	}

	/* --- the five steps ------------------------------------------------ */
	.pr__steps {
		position: relative;
		z-index: 1;
		padding-bottom: clamp(4rem, 10vw, 9rem);
		row-gap: 0;
	}

	.pr__step {
		grid-column: 1 / 13;
		display: grid;
		grid-template-columns: minmax(4.5rem, 1fr) minmax(0, 3fr) minmax(0, 3fr);
		align-items: baseline;
		gap: 0.375rem clamp(0.75rem, 2.5vw, 2.5rem);
		padding-block: clamp(1.5rem, 3.4vw, 3rem);
		border-top: var(--hairline) solid var(--d10-rule);
		position: relative;
	}

	.pr__step:last-child {
		border-bottom: var(--hairline) solid var(--d10-rule);
	}

	.pr__n {
		font-family: var(--font-grotesk);
		font-weight: 700;
		font-size: clamp(2.5rem, 8vw, 6.5rem);
		line-height: 0.8;
		letter-spacing: -0.05em;
		color: var(--d10-paper-lo);
		transition: color 0.35s ease;
	}

	.pr__en {
		font-family: var(--font-grotesk);
		font-weight: 700;
		font-size: clamp(1.25rem, 3.4vw, 2.75rem);
		line-height: 1;
		letter-spacing: -0.03em;
		color: var(--d10-ink);
	}

	.pr__zh {
		font-family: var(--font-cjk);
		font-size: clamp(0.875rem, 1.1vw, 1rem);
		letter-spacing: 0.14em;
		line-height: 1.9;
		color: var(--d10-quiet);
	}

	.pr__rule {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		height: 0.1875rem;
		background: var(--d10-accent);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 0.55s cubic-bezier(0.22, 0.65, 0.2, 1);
	}

	.pr__step.is-on .pr__rule {
		transform: scaleX(1);
	}

	.pr__step.is-on .pr__n {
		color: var(--d10-accent);
	}

	@media (max-width: 63.99em) {
		.pr__stage {
			height: 150svh;
		}

		.pr__h {
			grid-column: 2 / 13;
		}

		.pr__readout {
			grid-column: 2 / 13;
		}

		.pr__step {
			grid-template-columns: minmax(3.5rem, 1fr) minmax(0, 4fr);
		}

		.pr__zh {
			grid-column: 2;
		}
	}
</style>
