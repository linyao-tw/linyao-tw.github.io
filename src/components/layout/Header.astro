---
import { brand, cta, nav } from "../../lib/copy";

/** "/#services" stays a smooth in-page jump while on the home page */
const onHome = Astro.url.pathname === "/";
const href = (h: string) => (onHome && h.startsWith("/#") ? h.slice(1) : h);
---

<header class="head" id="ly-head">
	<a class="mark" href="#top">
		<span class="zh">{brand.nameZh}</span>
		<span class="en">{brand.nameEn}</span>
	</a>

	<div class="right">
		<nav class="desk" aria-label="主要導覽">
			<ul>
				{
					nav.map(n => (
						<li>
							<a href={href(n.href)}>{n.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<button class="cta" type="button" data-ly-inquiry>{cta.button}</button>

		<button class="burger" type="button" id="ly-burger" aria-expanded="false" aria-controls="ly-menu">
			<span class="visually-hidden">選單</span>
			<span class="bars" aria-hidden="true"><i></i><i></i></span>
			<span class="btxt" aria-hidden="true">選單</span>
		</button>
	</div>
</header>

<div class="menu" id="ly-menu" hidden>
	<nav aria-label="行動裝置導覽">
		<ul>
			{
				nav.map(n => (
					<li>
						<a href={href(n.href)} data-ly-menu-link>
							<span class="cjk">{n.label}</span>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
	<div class="mfoot">
		<button class="mcta" type="button" data-ly-inquiry>{cta.button}</button>
		<a class="mmail" href={`mailto:${brand.email}`}>{brand.email}</a>
	</div>
</div>

<style>
	.head {
		position: fixed;
		inset-block-start: 0;
		inset-inline: 0;
		z-index: 60;
		display: flex;
		/* the mark is a two-line lockup and the nav a single row — centre them
		   against each other so the masthead reads as one line */
		align-items: center;
		justify-content: space-between;
		gap: var(--s-4);
		padding: clamp(0.85rem, 1.8vw, 1.5rem) var(--edge);
		mix-blend-mode: multiply;
		pointer-events: none;
		transition: background-color 0.25s linear;
	}

	/* once the page moves, oversized type runs under the masthead — it needs ground */
	.head.is-solid {
		mix-blend-mode: normal;
		background: var(--paper);
		border-bottom: var(--hairline) solid var(--rule);
		padding-block: clamp(0.7rem, 1.4vw, 1.1rem);
	}

	.head > * {
		pointer-events: auto;
	}

	.mark {
		display: grid;
		gap: 0.1rem;
		line-height: 1.05;
	}

	.mark .zh {
		font-family: var(--font-cjk);
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		color: var(--ink);
	}

	.mark .en {
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.24em;
		color: var(--dim);
	}

	.desk {
		display: none;
	}

	.right {
		display: flex;
		align-items: center;
		gap: clamp(0.75rem, 2vw, 1.75rem);
	}

	.desk ul {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 2.4vw, 2.25rem);
	}

	.desk a {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-family: var(--font-cjk);
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		color: var(--ink);
	}

	.desk a:hover,
	.desk a:focus-visible {
		color: var(--accent-txt);
	}

	/* --- primary action ------------------------------------------------ */
	.cta {
		display: none;
		align-items: center;
		min-height: 2.75rem;
		padding-inline: clamp(0.9rem, 1.8vw, 1.35rem);
		background: var(--accent);
		color: var(--paper-hi);
		font-family: var(--font-cjk);
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.14em;
	}

	.cta:hover,
	.cta:focus-visible {
		background: var(--ink);
	}

	/* --- burger ------------------------------------------------------- */
	.burger {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		min-width: 2.75rem;
		justify-content: flex-end;
	}

	.bars {
		display: grid;
		gap: 0.3rem;
		width: 1.5rem;
	}

	.bars i {
		display: block;
		height: 1px;
		background: var(--ink);
	}

	.btxt {
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.2em;
		color: var(--ink);
	}

	.burger[aria-expanded="true"] .bars i:first-child {
		background: var(--accent);
	}

	/* --- full screen menu --------------------------------------------- */
	.menu {
		position: fixed;
		inset: 0;
		z-index: 58;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--s-8);
		padding: clamp(4.5rem, 14vh, 7rem) var(--edge) var(--edge);
		background: var(--paper);
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.menu[hidden] {
		display: none;
	}

	.menu ul {
		border-top: var(--hairline) solid var(--rule-soft);
	}

	.menu li {
		border-bottom: var(--hairline) solid var(--rule-soft);
	}

	.menu li a {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding-block: clamp(0.7rem, 2.4vh, 1.1rem);
		min-height: 2.75rem;
	}

	.menu i {
		font-family: var(--font-mono);
		font-style: normal;
		font-size: 0.6rem;
		letter-spacing: 0.1em;
		color: var(--accent-txt);
	}

	.menu .lat {
		font-size: clamp(1.75rem, 9vw, 2.75rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 0.95;
	}

	.menu .cjk {
		font-family: var(--font-cjk);
		font-size: 0.8rem;
		letter-spacing: 0.24em;
		color: var(--dim);
		margin-inline-start: auto;
	}

	.mfoot {
		display: grid;
		gap: 1rem;
	}

	.mcta {
		justify-self: start;
		font-family: var(--font-cjk);
		font-size: clamp(1.5rem, 8vw, 2.25rem);
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--accent);
		min-height: 2.75rem;
	}

	.mmail {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		color: var(--dim);
	}

	@media (min-width: 62rem) {
		.cta {
			display: inline-flex;
		}

		.desk {
			display: block;
		}

		.burger,
		.menu {
			display: none;
		}
	}
</style>

<script>
	const head = document.getElementById("ly-head");
	if (head) {
		const onScroll = () => head.classList.toggle("is-solid", window.scrollY > 48);
		window.addEventListener("scroll", onScroll, { passive: true });
		onScroll();
	}

	const burger = document.getElementById("ly-burger");
	const menu = document.getElementById("ly-menu");

	if (burger && menu) {
		const body = document.body;
		const focusables = () => Array.from(menu.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"));

		const setOpen = (open: boolean) => {
			burger.setAttribute("aria-expanded", String(open));
			menu.hidden = !open;
			body.classList.toggle("ly-locked", open);
			if (open) focusables()[0]?.focus();
			else burger.focus();
		};

		burger.addEventListener("click", () => setOpen(Boolean(menu.hidden)));

		menu.querySelectorAll("[data-ly-menu-link]").forEach(a => a.addEventListener("click", () => setOpen(false)));

		document.addEventListener("keydown", event => {
			if (menu.hidden) return;
			if (event.key === "Escape") {
				event.preventDefault();
				setOpen(false);
				return;
			}
			if (event.key !== "Tab") return;
			const items = focusables();
			if (!items.length) return;
			const first = items[0];
			const last = items[items.length - 1];
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		});

		const wide = window.matchMedia("(min-width: 62rem)");
		wide.addEventListener("change", e => {
			if (e.matches && !menu.hidden) setOpen(false);
		});
	}
</script>
