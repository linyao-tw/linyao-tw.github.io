---
import { services } from "../../lib/copy";

/* Chinese line breaks are designed, not left to the browser. Sliced from the
   canonical string so copy.ts stays the single source of truth. */
const leadParts = [services.lead.slice(0, 12), services.lead.slice(12, 20), services.lead.slice(20)];
---

<section id="services" class="d06-svc" aria-labelledby="svc-h">
	<div class="svc__head d06-wrap">
		<div class="d06-run">
			<span class="d06-run__i">SECTION 03 / 09</span>
			<span class="d06-run__l"></span>
			<span class="d06-run__d">RAIL 03 · TRACK</span>
			<span class="d06-run__t">SERVICES</span>
		</div>

		<div class="svc__head-grid">
			<h2 id="svc-h" class="svc__lead">
				{
					leadParts.map(part => (
						<span class="d06-rowclip">
							<span class="svc__lead-l">{part}</span>
						</span>
					))
				}
			</h2>

			<ol class="svc__map">
				{
					services.items.map(s => (
						<li>
							<span class="svc__map-i">{s.index}</span>
							<span class="svc__map-e">{s.en}</span>
							<span class="svc__map-p">{s.position}</span>
						</li>
					))
				}
			</ol>
		</div>
	</div>

	<div class="d06-svc__pin">
		<div class="d06-svc__track">
			{
				services.items.map((s, i) => (
					<article class={`d06-svc__panel svc-k${i + 1}`} aria-labelledby={`svc-${s.index}`}>
						<div class="svc__p-in d06-wrap">
							<header class="svc__p-head">
								<span class="svc__p-idx">{s.index}</span>
								<span class="svc__p-rule" />
								<span class="svc__p-pos">{s.position}</span>
							</header>

							<div class="svc__p-mid">
								<h3 id={`svc-${s.index}`} class="svc__p-title">
									<span class="svc__p-en">{s.en}</span>
									<span class="svc__p-zh">{s.zh}</span>
								</h3>
								<div class="svc__p-body">
									{s.body.map(l => (
										<p>{l}</p>
									))}
								</div>
							</div>

							<span class="d06-svc__mark" aria-hidden="true" />

							<ul class="svc__p-stack">
								{s.stack.map((t, n) => (
									<li>
										<span class="svc__p-sn">{String(n + 1).padStart(2, "0")}</span>
										<span class="svc__p-st">{t}</span>
									</li>
								))}
							</ul>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.d06-svc {
		position: relative;
		padding-top: clamp(2rem, 6vh, 4rem);
	}

	.svc__head {
		display: grid;
		gap: clamp(2rem, 6vh, 3.5rem);
		padding-bottom: clamp(3rem, 9vh, 5.5rem);
	}

	.svc__head-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: end;
	}

	.svc__lead {
		display: grid;
		gap: 0.1rem;
		font-size: clamp(1.125rem, 2.3vw, 1.875rem);
		line-height: 1.45;
		letter-spacing: 0.005em;
		font-weight: 500;
	}

	.svc__lead-l {
		display: block;
		will-change: transform;
	}

	.svc__map {
		display: grid;
		gap: 0;
	}

	.svc__map li {
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr);
		grid-template-areas: "i e" ". p";
		gap: 0.15rem 0.75rem;
		border-top: var(--hairline) solid var(--rule);
		padding-block: 0.85rem;
	}

	.svc__map li:last-child {
		border-bottom: var(--hairline) solid var(--rule);
	}

	.svc__map-i {
		grid-area: i;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.16em;
		color: var(--fg);
		padding-top: 0.25em;
	}

	.svc__map-i::before {
		content: "";
		width: 0.375rem;
		height: 0.375rem;
		background: var(--orange);
		flex: none;
	}

	.svc__map-e {
		grid-area: e;
		font-family: var(--font-mono);
		font-size: clamp(0.8125rem, 1.3vw, 1rem);
		letter-spacing: 0.14em;
	}

	.svc__map-p {
		grid-area: p;
		font-size: 0.8125rem;
		color: var(--fg-dim);
		letter-spacing: 0.02em;
	}

	/* --- the sequence ---------------------------------------------------
	   Stacked is the authored default: with JS off, below 64rem, or under
	   reduced motion this is simply three sections one after another. The
	   horizontal layout is applied by the timeline, never by CSS. */
	.d06-svc__pin {
		position: relative;
		overflow: clip;
	}

	.d06-svc__track {
		display: grid;
	}

	.d06-svc__panel {
		position: relative;
		display: grid;
		border-top: var(--hairline) solid var(--rule-hi);
	}

	.svc__p-in {
		display: grid;
		grid-template-rows: auto minmax(0, 1fr) 0 auto;
		gap: clamp(1rem, 3vh, 3rem);
		width: 100%;
		height: 100%;
		padding-block: clamp(2.25rem, 6vh, 3.5rem);
	}

	@media (min-width: 64rem) {
		/* the pinned panel fills the viewport, so it has to clear the header */
		.svc__p-in {
			padding-block: calc(var(--bar-h) + clamp(1rem, 3vh, 2rem)) clamp(2.5rem, 6vh, 4rem);
		}
	}

	.svc__p-head {
		display: flex;
		align-items: center;
		gap: 1rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.16em;
	}

	.svc__p-idx {
		font-size: clamp(1.75rem, 3.4vw, 3rem);
		letter-spacing: -0.02em;
		line-height: 1;
		color: var(--fg-dim);
		transition: color 0.4s ease;
	}

	.d06-svc__panel.is-current .svc__p-idx {
		color: var(--orange);
	}

	.svc__p-rule {
		flex: 0 0 auto;
		width: clamp(1.5rem, 5vw, 4rem);
		height: var(--hairline);
		background: var(--rule-hi);
	}

	.svc__p-pos {
		font-family: var(--font-grotesk);
		font-size: 0.8125rem;
		letter-spacing: 0.06em;
		color: var(--fg-dim);
	}

	.svc__p-mid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
		gap: clamp(1.25rem, 4vw, 4rem);
		align-content: center;
		align-items: end;
	}

	.svc__p-title {
		display: grid;
		gap: 0.5rem;
	}

	.svc__p-en {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-family: var(--font-mono);
		font-size: clamp(0.875rem, 1.8vw, 1.375rem);
		letter-spacing: 0.16em;
		color: var(--fg);
	}

	.svc__p-en::before {
		content: "";
		width: 0.625rem;
		height: 0.625rem;
		background: var(--orange);
		flex: none;
	}

	.svc__p-zh {
		display: block;
		font-size: clamp(2.75rem, 8vw, 6.5rem);
		line-height: 0.98;
		letter-spacing: -0.01em;
		font-weight: 600;
	}

	.svc__p-body {
		display: grid;
		gap: 0.2rem;
		padding-bottom: 0.6rem;
		border-bottom: var(--hairline) solid var(--rule);
	}

	.svc__p-body p {
		font-size: clamp(0.875rem, 1.1vw, 1rem);
		line-height: 1.95;
		color: var(--fg-dim);
	}

	.d06-svc__mark {
		display: block;
		height: 0;
	}

	.svc__p-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		padding-top: clamp(1.25rem, 3.5vh, 2.5rem);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
	}

	.svc__p-stack li {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
	}

	.svc__p-sn {
		font-size: 0.5625rem;
		color: var(--fg-faint);
		letter-spacing: 0.14em;
	}

	/* --- three genuinely different treatments -------------------------- */

	/* 01 WEB — stacked horizontal strata: the layers of a page */
	.svc-k1::before {
		content: "";
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(to bottom, color-mix(in oklab, var(--graphite) 12%, transparent) 0 var(--hairline), transparent var(--hairline) 1.5rem);
		opacity: 0.5;
		pointer-events: none;
	}

	.svc-k1 .svc__p-stack li {
		border-left: 0.125rem solid var(--orange);
		padding-left: 0.6rem;
	}

	/* 02 SYSTEM — a schematic column grid, tabular stack */
	.svc-k2::before {
		content: "";
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(to right, color-mix(in oklab, var(--graphite) 13%, transparent) 0 var(--hairline), transparent var(--hairline) 4.5rem);
		opacity: 0.55;
		pointer-events: none;
	}

	.svc-k2 .svc__p-stack {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0;
	}

	.svc-k2 .svc__p-stack li {
		border-top: var(--hairline) solid var(--rule);
		padding: 0.55rem 0.75rem 0.55rem 0;
	}

	.svc-k2 .svc__p-title {
		border-left: 0.125rem solid var(--orange);
		padding-left: clamp(0.75rem, 2vw, 1.5rem);
	}

	/* 03 CREATIVE — an amplitude reading; the stack cascades */
	.svc-k3 .svc__p-stack {
		display: grid;
		gap: 0;
	}

	.svc-k3 .svc__p-stack li {
		padding-block: 0.34rem;
		padding-left: calc(var(--n) * clamp(0.5rem, 1.6vw, 1.75rem));
		transition: padding-left 0.4s ease;
	}

	.svc-k3 .svc__p-stack li:nth-child(1) {
		--n: 0;
	}
	.svc-k3 .svc__p-stack li:nth-child(2) {
		--n: 1;
	}
	.svc-k3 .svc__p-stack li:nth-child(3) {
		--n: 2;
	}
	.svc-k3 .svc__p-stack li:nth-child(4) {
		--n: 3;
	}
	.svc-k3 .svc__p-stack li:nth-child(5) {
		--n: 4;
	}
	.svc-k3 .svc__p-stack li:nth-child(6) {
		--n: 5;
	}

	.svc-k3::before {
		content: "";
		position: absolute;
		right: 0;
		bottom: 0;
		width: min(38%, 22rem);
		height: min(46%, 18rem);
		background: repeating-linear-gradient(to right, var(--orange) 0 0.1875rem, transparent 0.1875rem 1.125rem);
		-webkit-mask-image: linear-gradient(to top, #000 0%, transparent 100%);
		mask-image: linear-gradient(to top, #000 0%, transparent 100%);
		opacity: 0.5;
		pointer-events: none;
	}

	@media (max-width: 63.99rem) {
		.svc__head-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: clamp(1.75rem, 5vh, 3rem);
			align-items: start;
		}
		.svc__p-mid {
			grid-template-columns: minmax(0, 1fr);
			gap: clamp(1.25rem, 4vh, 2rem);
			align-items: start;
		}
		.svc-k2 .svc__p-stack {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 30rem) {
		.svc__p-head {
			flex-wrap: wrap;
			gap: 0.5rem 0.75rem;
		}
		.svc__p-pos {
			flex: 1 0 100%;
		}
		.svc-k2 .svc__p-stack {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import { motion, motionAt } from "../../lib/motion";

	motion(({ gsap }) => {
		gsap.from(".svc__map li", {
			opacity: 0,
			y: "1rem",
			duration: 0.7,
			ease: "power2.out",
			stagger: 0.08,
			scrollTrigger: { trigger: ".svc__map", start: "top 85%" }
		});

		gsap.from(".svc__lead-l", {
			yPercent: 110,
			duration: 0.9,
			ease: "power3.out",
			stagger: 0.07,
			scrollTrigger: { trigger: ".svc__lead", start: "top 88%" }
		});
	});

	/* Below 64rem the panels are a plain vertical stack, so each one gets the
	   same restrained line reveal every other section uses. Above it the
	   horizontal sequence is the motion and the panels stay untouched. */
	motionAt("(max-width: 63.99rem)", ({ gsap }) => {
		gsap.utils.toArray<HTMLElement>(".d06-svc__panel").forEach(panel => {
			gsap.from(panel.querySelectorAll(".svc__p-head, .svc__p-title, .svc__p-body, .svc__p-stack"), {
				opacity: 0,
				y: "1.25rem",
				duration: 0.8,
				ease: "power2.out",
				stagger: 0.08,
				scrollTrigger: { trigger: panel, start: "top 80%" }
			});
		});
	});
</script>
