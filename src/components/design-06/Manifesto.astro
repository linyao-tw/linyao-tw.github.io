---
import { manifesto } from "../../lib/copy";
---

<section id="manifesto" class="d06-mf d06-dark" aria-labelledby="mf-h">
	<div class="d06-mf__pin">
		<div class="mf__in d06-wrap">
			<div class="d06-run">
				<span class="d06-run__i">SECTION 05 / 09</span>
				<span class="d06-run__l"></span>
				<span class="d06-run__d">PINNED · SCRUB 00 → 01</span>
				<span class="d06-run__t">MANIFESTO</span>
			</div>

			<div class="mf__stage">
				<h2 id="mf-h" class="mf__h">
					<span class="mf__line mf__line--a">{manifesto.headlineParts[0]}</span>
					<span class="mf__line mf__line--b">{manifesto.headlineParts[1]}</span>
					<span class="mf__sweep" aria-hidden="true"></span>
				</h2>

				<div class="mf__body">
					{manifesto.body.map(line => <p class="mf__bline">{line}</p>)}
				</div>
			</div>

			<p class="mf__foot" aria-hidden="true">
				<span class="mf__foot-k">SCRUB</span>
				<span class="mf__foot-track"><span class="mf__foot-fill"></span></span>
				<span class="mf__foot-v">000</span>
			</p>
		</div>
	</div>
</section>

<style>
	.d06-mf {
		position: relative;
	}

	.d06-mf__pin {
		position: relative;
		min-height: 100svh;
		display: grid;
		overflow: clip;
	}

	.mf__in {
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: clamp(2rem, 6vh, 4rem);
		width: 100%;
		padding-block: clamp(2.5rem, 8vh, 4.5rem) clamp(2rem, 6vh, 3.5rem);
	}

	.mf__stage {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.62fr);
		gap: clamp(1.5rem, 5vw, 5rem);
		align-content: center;
		align-items: end;
	}

	.mf__h {
		position: relative;
		display: grid;
		gap: 0.15rem;
		font-size: clamp(2.5rem, 9.5vw, 8rem);
		line-height: 1.02;
		letter-spacing: -0.015em;
		font-weight: 600;
	}

	.mf__line {
		display: block;
		justify-self: start;
		white-space: nowrap;
	}

	.mf__line--a {
		color: var(--fg-dim);
	}

	.mf__line--b {
		color: var(--paper-hi);
	}

	/* Once the runtime is live the two statements share one cell, so the
	   second literally takes the place of the first. With JS off or reduced
	   motion they simply stack — a legible before/after pair. */
	:global(body.d-06.d06-live) .mf__line {
		grid-area: 1 / 1;
	}

	.mf__sweep {
		display: none;
	}

	:global(body.d-06.d06-live) .mf__sweep {
		display: block;
		position: absolute;
		left: 0;
		top: -0.06em;
		bottom: -0.06em;
		width: var(--rail-w);
		background: var(--orange);
		transform: translateX(0);
		opacity: 0;
	}

	.mf__body {
		display: grid;
		gap: 0.25rem;
		border-top: var(--hairline) solid var(--rule-hi);
		padding-top: 0.85rem;
		max-width: 17em;
	}

	.mf__bline {
		font-size: clamp(0.875rem, 1.2vw, 1.0625rem);
		line-height: 1.95;
		color: var(--fg-dim);
	}

	.mf__bline:last-child {
		color: var(--fg);
	}

	.mf__foot {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.16em;
		color: var(--fg-dim);
	}

	.mf__foot-k {
		color: var(--orange);
		flex: none;
	}

	.mf__foot-track {
		flex: 1 1 auto;
		height: var(--hairline);
		background: var(--rule);
		max-width: 22rem;
	}

	.mf__foot-fill {
		display: block;
		height: 100%;
		background: var(--orange);
		transform: scaleX(0);
		transform-origin: 0 50%;
	}

	.mf__foot-v {
		flex: none;
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 63.99rem) {
		.mf__stage {
			grid-template-columns: minmax(0, 1fr);
			gap: clamp(1.75rem, 5vh, 3rem);
			align-items: start;
		}
		.mf__body {
			max-width: 22em;
		}
	}

	@media (max-width: 30rem) {
		.mf__foot {
			font-size: 0.5625rem;
			letter-spacing: 0.1em;
			gap: 0.6rem;
		}
	}
</style>

<script>
	import { motion } from "../../lib/motion";

	motion(({ gsap }) => {
		document.body.classList.add("d06-live");

		const pin = document.querySelector<HTMLElement>(".d06-mf__pin");
		const a = document.querySelector<HTMLElement>(".mf__line--a");
		const b = document.querySelector<HTMLElement>(".mf__line--b");
		const readout = document.querySelector<HTMLElement>(".mf__foot-v");
		if (!pin || !a || !b) return;

		const tl = gsap.timeline({
			defaults: { ease: "none" },
			scrollTrigger: {
				trigger: pin,
				start: "top top",
				end: () => "+=" + Math.round(window.innerHeight * 1.15),
				pin: true,
				pinSpacing: true,
				anticipatePin: 1,
				/* refreshes after the services pin (20) and before everything
				   below it, so downstream scroll positions include both spacers */
				refreshPriority: 10,
				scrub: 0.5,
				invalidateOnRefresh: true,
				onUpdate: self => {
					gsap.set(".mf__foot-fill", { scaleX: self.progress });
					if (readout) readout.textContent = String(Math.round(self.progress * 100)).padStart(3, "0");
				}
			}
		});

		/* 我們不做網站 is cleared away, left to right … */
		tl.fromTo(a, { clipPath: "inset(0% 0% 0% 0%)" }, { clipPath: "inset(0% 0% 0% 100%)", duration: 0.5 }, 0);
		/* … and 我們創造體驗 takes its place behind the same edge. */
		tl.fromTo(b, { clipPath: "inset(0% 100% 0% 0%)" }, { clipPath: "inset(0% 0% 0% 0%)", duration: 0.5 }, 0.04);
		/* the orange edge doing the clearing */
		tl.fromTo(".mf__sweep", { x: 0, opacity: 1 }, { x: () => a.offsetWidth || 0, duration: 0.5 }, 0);
		tl.to(".mf__sweep", { opacity: 0, duration: 0.12 }, 0.5);

		tl.from(".mf__bline", { opacity: 0, y: "1rem", duration: 0.2, stagger: 0.07, ease: "power2.out" }, 0.52);
	});
</script>
