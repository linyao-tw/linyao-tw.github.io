---
import { brand, nav } from "../../lib/copy";
---

<footer class="d06-footer" id="colophon" aria-labelledby="foot-h">
	<div class="ft__in d06-wrap">
		<div class="d06-run">
			<span class="d06-run__i">SECTION 09 / 09</span>
			<span class="d06-run__l"></span>
			<span class="d06-run__d">RAIL · RELEASED</span>
			<span class="d06-run__t">COLOPHON</span>
		</div>

		<div class="ft__grid">
			<div class="ft__mark">
				<h2 id="foot-h" class="ft__en">{brand.nameEn}</h2>
				<p class="ft__zh">{brand.nameZh}</p>
				<p class="ft__eq">{brand.equation}</p>
			</div>

			<nav class="ft__nav" aria-label="頁尾導覽">
				<ul>
					{
						nav.map((n, i) => (
							<li>
								<a href={n.href}>
									<span class="ft__ni">{String(i + 1).padStart(2, "0")}</span>
									<span>{n.label}</span>
									<span class="ft__nz">{n.zh}</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="ft__contact">
				<a class="ft__mail" href={`mailto:${brand.email}`}>{brand.email}</a>
				<p class="ft__disc">{brand.disciplines}</p>
			</div>
		</div>

		<div class="ft__base">
			<p>{brand.copyright}</p>
			<p class="ft__colophon">
				<span>DESIGN 06</span>
				<span class="ft__sep" aria-hidden="true">/</span>
				<span>MOTION SYSTEM</span>
				<span class="ft__sep" aria-hidden="true">/</span>
				<span>ONE RAIL, FIVE ROLES</span>
			</p>
		</div>
	</div>
</footer>

<style>
	.d06-footer {
		padding-block: clamp(3rem, 9vh, 5rem) clamp(3.5rem, 9vh, 5rem);
		border-top: var(--hairline) solid var(--rule-hi);
	}

	.ft__in {
		display: grid;
		gap: clamp(2rem, 6vh, 3.5rem);
	}

	.ft__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr) minmax(0, 0.9fr);
		gap: clamp(1.75rem, 4vw, 3.5rem);
		align-items: start;
	}

	.ft__en {
		font-family: var(--font-mono);
		font-size: clamp(1.125rem, 2.6vw, 2rem);
		letter-spacing: 0.06em;
		line-height: 1.1;
		font-weight: 500;
	}

	.ft__zh {
		font-size: 0.9375rem;
		letter-spacing: 0.16em;
		color: var(--fg-dim);
		margin-top: 0.5rem;
	}

	.ft__eq {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.22em;
		color: var(--fg);
		margin-top: 1.25rem;
	}

	.ft__eq::before {
		content: "";
		width: 0.4375rem;
		height: 0.4375rem;
		background: var(--orange);
		flex: none;
	}

	.ft__nav ul {
		display: grid;
	}

	.ft__nav a {
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr) auto;
		gap: 0.6rem;
		align-items: baseline;
		border-top: var(--hairline) solid var(--rule);
		padding-block: 0.7rem;
		min-height: 2.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.14em;
	}

	.ft__nav a:hover,
	.ft__nav a:focus-visible {
		color: var(--fg);
		border-top-color: var(--orange);
	}

	.ft__ni {
		color: var(--fg-faint);
		font-size: 0.5625rem;
	}

	.ft__nz {
		font-family: var(--font-grotesk);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		color: var(--fg-dim);
	}

	.ft__contact {
		display: grid;
		gap: 1rem;
		justify-items: start;
	}

	.ft__mail {
		font-family: var(--font-mono);
		font-size: clamp(0.875rem, 1.6vw, 1.125rem);
		letter-spacing: 0.08em;
		border-bottom: 0.125rem solid var(--orange);
		padding-bottom: 0.3rem;
	}

	.ft__mail:hover,
	.ft__mail:focus-visible {
		color: var(--fg);
		border-bottom-width: 0.25rem;
	}

	.ft__disc {
		font-size: 0.8125rem;
		letter-spacing: 0.1em;
		color: var(--fg-dim);
	}

	.ft__base {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
		border-top: var(--hairline) solid var(--rule);
		padding-top: 1.1rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.18em;
		color: var(--fg-dim);
	}

	.ft__colophon {
		display: flex;
		gap: 0.7rem;
		flex-wrap: wrap;
	}

	.ft__sep {
		color: var(--orange);
	}

	@media (max-width: 63.99rem) {
		.ft__grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
		.ft__mark {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 30rem) {
		.ft__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
