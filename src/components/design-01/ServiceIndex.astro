---
import { services } from "../../lib/copy";
import ColumnRules from "./ColumnRules.astro";

/** hand-broken so the lead never wraps badly at display scale */
const leadParts = ["我們提供涵蓋視覺、品牌、", "網站與技術開發的", "完整數位設計服務。"];
---

<section class="svc" id="services" aria-labelledby="svc-title">
	<div class="d01-shell svc-head">
		<p class="d01-runhead">
			<b>03</b>
			<span>Services</span>
		</p>

		<h2 class="svc-lead d01-lines" id="svc-title">
			{
				leadParts.map(part => (
					<span class="d01-line">
						<span>{part}</span>
					</span>
				))
			}
		</h2>

		<p class="svc-meta">
			<span class="d01-rule d01-rule--hair d01-draw" aria-hidden="true"></span>
			<span class="d01-label">THREE DISCIPLINES — ONE TEAM</span>
			<span class="d01-label muted">網頁 / 系統 / 創意</span>
		</p>
	</div>

	<span class="d01-rule d01-rule--heavy svc-top-rule" aria-hidden="true"></span>

	<ol class="svc-index">
		{
			services.items.map(item => (
				<li class="row">
					<ColumnRules class="row-cols" />
					<div class="d01-shell row-grid">
						<p class="row-num" aria-hidden="true">
							{item.index}
						</p>
						<h3 class="row-title">
							<span class="row-en">{item.en}</span>
							<span class="row-zh">{item.zh}</span>
						</h3>
						<p class="row-pos">{item.position}</p>
						<p class="row-body">
							{item.body.map(line => (
								<span>{line}</span>
							))}
						</p>
						<ul class="row-stack">
							{item.stack.map((term, i) => (
								<li>
									{i > 0 && (
										<span class="slash" aria-hidden="true">
											/
										</span>
									)}
									{term}
								</li>
							))}
						</ul>
					</div>
				</li>
			))
		}
	</ol>

	<span class="d01-rule d01-rule--heavy svc-end-rule" aria-hidden="true"></span>
</section>

<style>
	.svc {
		position: relative;
	}

	/* --- head ---------------------------------------------------------- */
	.svc-head {
		padding-block: clamp(4rem, 11vh, 8rem) clamp(3rem, 8vh, 5.5rem);
		row-gap: 2.5rem;
		align-items: start;
	}
	.svc-lead {
		grid-column: 2 / 11;
		font-size: var(--display-3);
		font-weight: 700;
		line-height: 1.02;
		letter-spacing: -0.03em;
		color: var(--ink-display);
	}
	.svc-lead .d01-line:nth-child(2) > span {
		padding-left: clamp(1.5rem, 6vw, 6rem);
	}
	.svc-lead .d01-line:nth-child(3) > span {
		padding-left: clamp(3rem, 12vw, 12rem);
	}
	.svc-meta {
		grid-column: 11 / 13;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		align-self: end;
	}
	.svc-meta .muted {
		color: var(--graphite);
		letter-spacing: 0.08em;
	}

	.svc-top-rule {
		--rule-c: var(--graphite);
	}
	.svc-end-rule {
		--rule-c: var(--orange);
	}

	/* --- index rows ------------------------------------------------------ */
	.row {
		position: relative;
	}
	.row + .row {
		border-top: 0.25rem solid var(--graphite);
	}
	.row-cols {
		z-index: 0;
	}
	.row-grid {
		position: relative;
		z-index: 1;
		padding-block: clamp(2.5rem, 6vh, 4.5rem);
		row-gap: 1.5rem;
		align-items: start;
	}

	.row-num {
		grid-column: 1 / 3;
		font-size: calc(clamp(2.75rem, 6vw, 5.5rem) * var(--row-scale, 1));
		font-weight: 700;
		line-height: 0.78;
		letter-spacing: -0.05em;
		color: var(--orange);
		font-variant-numeric: lining-nums tabular-nums;
	}

	.row-title {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.row-en {
		display: block;
		font-size: calc(clamp(1.75rem, 4vw, 3.75rem) * var(--row-scale, 1));
		font-weight: 700;
		line-height: 0.94;
		letter-spacing: -0.04em;
		text-transform: uppercase;
		color: var(--ink-display);
	}
	.row-zh {
		display: block;
		font-size: clamp(1.125rem, 1.9vw, 1.625rem);
		font-weight: 500;
		letter-spacing: 0.06em;
		color: var(--graphite);
	}

	.row-pos {
		font-size: var(--small);
		font-weight: 500;
		letter-spacing: 0.02em;
		padding-top: 0.625rem;
		border-top: 1px solid var(--rule-hair);
	}

	.row-body {
		font-size: var(--body);
		line-height: 1.8;
		color: var(--graphite);
	}
	.row-body span {
		display: block;
	}

	.row-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem 0.5rem;
		font-size: var(--label);
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		line-height: 1.6;
	}
	.row-stack li {
		display: flex;
		gap: 0.5rem;
	}
	.row-stack .slash {
		color: color-mix(in oklab, var(--graphite) 64%, transparent);
	}

	/* --- 01 : wide title left, notes right ------------------------------- */
	.row:nth-child(1) .row-title {
		grid-column: 3 / 8;
	}
	.row:nth-child(1) .row-pos {
		grid-column: 3 / 6;
	}
	.row:nth-child(1) .row-body {
		grid-column: 8 / 12;
	}
	.row:nth-child(1) .row-stack {
		grid-column: 8 / 13;
	}

	/* --- 02 : narrower title, stack breaks into a column ----------------- */
	.row:nth-child(2) {
		--row-scale: 1.06;
	}
	.row:nth-child(2) .row-title {
		grid-column: 3 / 8;
	}
	.row:nth-child(2) .row-pos {
		grid-column: 3 / 7;
	}
	.row:nth-child(2) .row-body {
		grid-column: 8 / 11;
	}
	.row:nth-child(2) .row-stack {
		grid-column: 11 / 13;
		flex-direction: column;
		gap: 0.5rem;
		border-left: 1px solid var(--rule-hair);
		padding-left: 1rem;
	}
	.row:nth-child(2) .row-stack .slash {
		display: none;
	}

	/* --- 03 : title runs the full measure, notes tuck under -------------- */
	.row:nth-child(3) {
		--row-scale: 1.16;
	}
	.row:nth-child(3) .row-title {
		grid-column: 3 / 12;
	}
	.row:nth-child(3) .row-pos {
		grid-column: 3 / 7;
	}
	.row:nth-child(3) .row-body {
		grid-column: 7 / 10;
	}
	.row:nth-child(3) .row-stack {
		grid-column: 10 / 13;
		align-self: end;
		font-size: 0.75rem;
	}

	@media (max-width: 64rem) {
		.svc-lead {
			grid-column: 2 / 13;
		}
		.svc-meta {
			grid-column: 2 / 8;
			flex-direction: row;
			align-items: baseline;
			gap: 1rem;
			flex-wrap: wrap;
		}
		.svc-meta .d01-rule {
			width: 100%;
		}
		.row:nth-child(1) .row-title,
		.row:nth-child(2) .row-title,
		.row:nth-child(3) .row-title {
			grid-column: 3 / 10;
		}
		.row:nth-child(1) .row-pos,
		.row:nth-child(2) .row-pos,
		.row:nth-child(3) .row-pos {
			grid-column: 3 / 8;
		}
		.row:nth-child(1) .row-body,
		.row:nth-child(2) .row-body,
		.row:nth-child(3) .row-body {
			grid-column: 3 / 10;
		}
		.row:nth-child(1) .row-stack,
		.row:nth-child(2) .row-stack,
		.row:nth-child(3) .row-stack {
			grid-column: 3 / 13;
			flex-direction: row;
			border-left: 0;
			padding-left: 0;
			align-self: start;
		}
		.row:nth-child(2) .row-stack .slash {
			display: block;
		}
	}

	@media (max-width: 60rem) {
		.svc-lead {
			grid-column: 1 / -1;
		}
		.svc-meta {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 40rem) {
		.row-grid {
			row-gap: 1rem;
		}
		.row-num {
			grid-column: 1 / -1;
			line-height: 0.85;
		}
		.row:nth-child(1) .row-title,
		.row:nth-child(2) .row-title,
		.row:nth-child(3) .row-title,
		.row:nth-child(1) .row-pos,
		.row:nth-child(2) .row-pos,
		.row:nth-child(3) .row-pos,
		.row:nth-child(1) .row-body,
		.row:nth-child(2) .row-body,
		.row:nth-child(3) .row-body,
		.row:nth-child(1) .row-stack,
		.row:nth-child(2) .row-stack,
		.row:nth-child(3) .row-stack {
			grid-column: 1 / -1;
		}
		.row:nth-child(2),
		.row:nth-child(3) {
			--row-scale: 1;
		}
	}
</style>
