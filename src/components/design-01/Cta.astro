---
import { brand, cta } from "../../lib/copy";
import ColumnRules from "./ColumnRules.astro";
---

<section class="cta" id="contact" aria-labelledby="cta-title">
	<span class="d01-disc cta-disc" aria-hidden="true"></span>
	<ColumnRules class="cta-cols" />

	<div class="d01-shell cta-grid">
		<p class="d01-runhead">
			<b>08</b>
			<span>Contact</span>
		</p>

		<h2 class="cta-title d01-lines" id="cta-title" data-headline={cta.headline}>
			{
				cta.headlineParts.map(part => (
					<span class="d01-line">
						<span>{part}</span>
					</span>
				))
			}
		</h2>

		<div class="cta-note">
			<span class="d01-rule d01-rule--hair d01-draw" aria-hidden="true"></span>
			<p class="cta-body">
				{cta.body.map(line => <span>{line}</span>)}
			</p>
			<p class="cta-mail">
				<span class="d01-label">DIRECT</span>
				<a href={`mailto:${brand.email}`}>{brand.email}</a>
			</p>
			<p class="cta-act-note d01-label">回覆時間 1–2 個工作天</p>
		</div>

		<div class="cta-act">
			<button class="cta-btn" type="button" data-inquiry-open>
				<span class="cta-btn-label">{cta.button}</span>
				<span class="cta-btn-rule" aria-hidden="true"></span>
			</button>
		</div>
	</div>
</section>

<style>
	.cta {
		position: relative;
		overflow: clip;
		min-height: clamp(32rem, 76vh, 56rem);
		display: flex;
		border-bottom: 1px solid var(--rule-hair);
	}
	.cta-disc {
		left: 74%;
		top: 40%;
		width: 52vw;
		aspect-ratio: 1;
	}
	.cta-cols {
		z-index: 0;
	}

	.cta-grid {
		position: relative;
		z-index: 1;
		width: 100%;
		align-content: center;
		padding-block: clamp(4rem, 12vh, 8rem);
		row-gap: clamp(2rem, 6vh, 4rem);
		align-items: start;
	}

	.cta-title {
		grid-column: 2 / 9;
		font-size: clamp(2.25rem, 5.8vw, 5.5rem);
		font-weight: 700;
		line-height: 0.98;
		letter-spacing: var(--tr-display);
		color: var(--ink-display);
	}
	.cta-title .d01-line:last-child > span {
		padding-left: clamp(1.5rem, 6vw, 6rem);
	}

	.cta-note {
		grid-column: 2 / 7;
		display: grid;
		gap: 1.125rem;
	}
	.cta-body {
		font-size: var(--body);
		line-height: 1.85;
	}
	.cta-body span {
		display: block;
	}
	.cta-mail {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		margin-top: 0.5rem;
	}
	.cta-mail .d01-label {
		color: var(--graphite);
	}
	.cta-mail a {
		font-size: clamp(1rem, 1.5vw, 1.25rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--ink-display);
		border-bottom: 1px solid var(--rule-hair);
		align-self: start;
	}
	.cta-mail a:hover {
		border-bottom-color: var(--graphite);
	}

	.cta-act {
		grid-column: 8 / 12;
		align-self: end;
		display: grid;
		gap: 1rem;
		justify-items: start;
	}
	.cta-btn {
		display: grid;
		gap: 1.25rem;
		background: var(--graphite);
		color: var(--warm-gray);
		padding: 1.25rem 1.5rem 1.125rem;
		min-height: 2.75rem;
		min-width: min(100%, 16rem);
		text-align: left;
	}
	.cta-btn-label {
		font-size: clamp(1.125rem, 1.7vw, 1.5rem);
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	.cta-btn-rule {
		display: block;
		height: 0.25rem;
		width: 100%;
		background: var(--orange);
		transform-origin: left center;
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.cta-btn:hover {
		background: var(--ink-black);
	}
	.cta-btn:hover .cta-btn-rule {
		transform: scaleX(0.45);
	}
	.cta-act-note {
		margin-top: 0.25rem;
		color: var(--graphite);
	}

	@media (max-width: 64rem) {
		.cta-disc {
			left: 70%;
			top: 44%;
			width: 62vw;
		}
		.cta-title {
			grid-column: 2 / 11;
		}
		.cta-note {
			grid-column: 2 / 8;
		}
		.cta-act {
			grid-column: 8 / 13;
		}
	}

	@media (max-width: 60rem) {
		.cta-title,
		.cta-note,
		.cta-act {
			grid-column: 1 / -1;
		}
		.cta-act {
			align-self: start;
		}
	}

	@media (max-width: 48rem) {
		.cta-disc {
			left: 52%;
			top: 66%;
			width: 120vw;
		}
		.cta {
			min-height: auto;
		}
	}
</style>
