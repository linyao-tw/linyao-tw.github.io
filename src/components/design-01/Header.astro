---
import { brand, cta, nav } from "../../lib/copy";
---

<header class="head">
	<div class="d01-shell head-in">
		<a class="mark" href="#main">
			<span class="mark-disc" aria-hidden="true"></span>
			<span class="mark-zh">{brand.nameZh}</span>
			<span class="mark-en">{brand.nameEn}</span>
		</a>

		<nav class="nav" aria-label="主要導覽">
			<ul>
				{
					nav.map((item, i) => (
						<li>
							<a href={item.href}>
								<i aria-hidden="true">{String(i + 1).padStart(2, "0")}</i>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<button class="head-cta d01-label" type="button" data-inquiry-open>{cta.button}</button>

		<button class="burger d01-label" type="button" aria-expanded="false" aria-controls="d01-menu" id="d01-burger">
			<span class="burger-txt">MENU</span>
			<span class="burger-mark" aria-hidden="true"><i></i><i></i></span>
		</button>
	</div>

	<div class="menu" id="d01-menu" hidden>
		<div class="d01-shell menu-in">
			<p class="menu-idx d01-label">INDEX</p>
			<nav class="menu-nav" aria-label="行動版導覽">
				<ul>
					{
						nav.map((item, i) => (
							<li>
								<a href={item.href} data-menu-link>
									<i aria-hidden="true">{String(i + 1).padStart(2, "0")}</i>
									<b>{item.label}</b>
									<em>{item.zh}</em>
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<div class="menu-foot">
				<span class="d01-rule d01-rule--mid"></span>
				<a class="menu-mail" href={`mailto:${brand.email}`}>{brand.email}</a>
				<button class="menu-cta" type="button" data-inquiry-open data-menu-link>{cta.button}</button>
			</div>
		</div>
	</div>
</header>

<style>
	.head {
		position: sticky;
		top: 0;
		z-index: 40;
		background: var(--warm-gray);
		border-bottom: 1px solid var(--rule-hair);
	}

	.head-in {
		align-items: center;
		min-height: var(--head-h);
		row-gap: 0;
	}

	.mark {
		grid-column: 1 / 6;
		display: flex;
		align-items: baseline;
		gap: 0.625rem;
		padding-block: 0.5rem;
	}
	.mark-disc {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--orange);
		flex: none;
		align-self: center;
	}
	.mark-zh {
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	.mark-en {
		font-size: var(--label);
		font-weight: 500;
		letter-spacing: var(--tr-label);
		text-transform: uppercase;
		color: var(--graphite);
	}

	.nav {
		grid-column: 6 / 11;
	}
	.nav ul {
		display: flex;
		gap: clamp(1rem, 2.4vw, 2.5rem);
	}
	.nav a {
		display: flex;
		align-items: baseline;
		gap: 0.375rem;
		font-size: var(--label);
		font-weight: 500;
		letter-spacing: var(--tr-label);
		text-transform: uppercase;
		padding-block: 1.0625rem;
	}
	.nav a i {
		font-style: normal;
		font-size: 0.5625rem;
		color: var(--graphite);
		font-variant-numeric: tabular-nums;
	}
	.nav a:hover {
		color: var(--ink-black);
	}
	.nav a:hover i {
		color: var(--ink-black);
	}

	.head-cta {
		grid-column: 11 / 13;
		justify-self: end;
		align-self: stretch;
		display: flex;
		align-items: center;
		padding-inline: 1rem;
		background: var(--graphite);
		color: var(--warm-gray);
		min-height: 2.75rem;
		white-space: nowrap;
	}
	.head-cta:hover {
		background: var(--orange);
		color: var(--ink-black);
	}

	.burger {
		display: none;
		grid-column: 10 / 13;
		justify-self: end;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		min-width: 2.75rem;
		justify-content: flex-end;
	}
	.burger-mark {
		display: grid;
		gap: 0.25rem;
		width: 1.125rem;
	}
	.burger-mark i {
		display: block;
		height: 1px;
		background: var(--graphite);
	}
	.burger[aria-expanded="true"] .burger-mark i:first-child {
		background: var(--orange);
	}

	/* --- mobile index panel ------------------------------------------- */
	.menu {
		position: fixed;
		inset: var(--head-h) 0 0 0;
		background: var(--warm-gray);
		z-index: 39;
		overflow-y: auto;
		border-top: 1px solid var(--rule-hair);
	}
	.menu[hidden] {
		display: none;
	}
	.menu-in {
		align-content: start;
		padding-block: 1.5rem 2.5rem;
		min-height: 100%;
	}
	.menu-idx {
		grid-column: 1 / -1;
		color: var(--graphite);
		margin-bottom: 0.75rem;
	}
	.menu-nav {
		grid-column: 1 / -1;
	}
	.menu-nav a {
		display: grid;
		grid-template-columns: 2.5rem 1fr auto;
		align-items: baseline;
		gap: 0.75rem;
		padding-block: 0.875rem;
		border-top: 1px solid var(--rule-hair);
	}
	.menu-nav li:last-child a {
		border-bottom: 1px solid var(--rule-hair);
	}
	.menu-nav i {
		font-style: normal;
		font-size: var(--label);
		letter-spacing: var(--tr-label);
		color: var(--graphite);
		font-variant-numeric: tabular-nums;
	}
	.menu-nav b {
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: -0.03em;
	}
	.menu-nav em {
		font-style: normal;
		font-size: var(--small);
		color: var(--graphite);
	}
	.menu-foot {
		grid-column: 1 / -1;
		margin-top: 2rem;
		display: grid;
		gap: 1rem;
		justify-items: start;
	}
	.menu-mail {
		font-size: 1.125rem;
		font-weight: 500;
		border-bottom: 1px solid var(--rule-hair);
	}
	.menu-cta {
		background: var(--graphite);
		color: var(--warm-gray);
		font-size: var(--label);
		font-weight: 500;
		letter-spacing: var(--tr-label);
		text-transform: uppercase;
		padding: 0.9375rem 1.25rem;
		min-height: 2.75rem;
	}

	@media (max-width: 64rem) {
		.mark {
			grid-column: 1 / 8;
		}
		.nav,
		.head-cta {
			display: none;
		}
		.burger {
			display: flex;
		}
	}
	@media (max-width: 30rem) {
		.mark-en {
			display: none;
		}
	}
</style>

<script>
	const burger = document.getElementById("d01-burger");
	const menu = document.getElementById("d01-menu");

	if (burger && menu) {
		const setOpen = (open: boolean) => {
			burger.setAttribute("aria-expanded", String(open));
			menu.hidden = !open;
			document.documentElement.style.overflow = open ? "hidden" : "";
			if (open) menu.querySelector<HTMLElement>("a, button")?.focus();
		};

		burger.addEventListener("click", () => {
			setOpen(burger.getAttribute("aria-expanded") !== "true");
		});

		menu.querySelectorAll<HTMLElement>("[data-menu-link]").forEach(el => {
			el.addEventListener("click", () => {
				setOpen(false);
				burger.focus();
			});
		});

		document.addEventListener("keydown", event => {
			if (event.key === "Escape" && burger.getAttribute("aria-expanded") === "true") {
				setOpen(false);
				burger.focus();
			}
		});

		const mq = window.matchMedia("(min-width: 64.0625rem)");
		mq.addEventListener("change", () => {
			if (mq.matches) setOpen(false);
		});
	}
</script>
