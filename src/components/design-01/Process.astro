---
import { process } from "../../lib/copy";
---

<section class="proc" id="process" aria-labelledby="proc-title">
	<div class="d01-shell proc-head">
		<p class="d01-runhead">
			<b>06</b>
			<span>Process</span>
		</p>

		<h2 class="proc-title d01-lines" id="proc-title">
			{
				process.headlineParts.map(part => (
					<span class="d01-line">
						<span>{part}</span>
					</span>
				))
			}
		</h2>

		<p class="proc-side d01-label">
			HOW WE WORK<br />五個階段，從探索到上線
		</p>
	</div>

	<ol class="proc-list">
		{
			process.steps.map(step => (
				<li class="step">
					<div class="d01-shell step-grid">
						<p class="step-num" aria-hidden="true">
							{step.index}
						</p>
						<h3 class="step-en">{step.en}</h3>
						<p class="step-zh">{step.zh}</p>
						<span class="step-tick" aria-hidden="true" />
					</div>
				</li>
			))
		}
	</ol>
</section>

<style>
	.proc {
		border-bottom: 1px solid var(--rule-hair);
	}
	.proc-head {
		padding-block: clamp(4rem, 11vh, 8rem) clamp(2.5rem, 6vh, 4rem);
		align-items: start;
		row-gap: 2rem;
	}
	.proc-title {
		grid-column: 2 / 10;
		font-size: var(--display-3);
		font-weight: 700;
		line-height: 0.96;
		letter-spacing: var(--tr-display);
		color: var(--ink-display);
	}
	.proc-title .d01-line:last-child > span {
		padding-left: clamp(2rem, 8vw, 8rem);
	}
	.proc-side {
		grid-column: 11 / 13;
		align-self: end;
		text-align: right;
		line-height: 2;
		color: var(--graphite);
	}

	.proc-list {
		border-top: 0.25rem solid var(--graphite);
	}
	.step + .step {
		border-top: 1px solid var(--rule-hair);
	}
	.step-grid {
		align-items: baseline;
		padding-block: clamp(1.25rem, 3.2vh, 2.25rem);
		row-gap: 0.5rem;
	}
	.step:hover {
		background: color-mix(in oklab, var(--paper-hi) 55%, transparent);
	}

	.step-num {
		grid-column: 1 / 2;
		font-size: clamp(1.5rem, 2.6vw, 2.75rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.04em;
		color: var(--orange);
		font-variant-numeric: lining-nums tabular-nums;
	}
	.step-en {
		grid-column: 2 / 7;
		font-size: clamp(1.5rem, 3.6vw, 3.25rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.04em;
		text-transform: uppercase;
		color: var(--ink-display);
	}
	.step-zh {
		grid-column: 8 / 12;
		font-size: clamp(0.9375rem, 1.3vw, 1.125rem);
		font-weight: 500;
		letter-spacing: 0.05em;
	}
	.step-tick {
		grid-column: 12 / 13;
		justify-self: end;
		width: 1rem;
		height: 1rem;
		border: 1px solid var(--rule-hair);
		align-self: center;
	}
	.step:last-child .step-tick {
		background: var(--orange);
		border-color: var(--orange);
	}

	@media (max-width: 64rem) {
		.proc-title {
			grid-column: 2 / 13;
		}
		.proc-side {
			grid-column: 8 / 13;
		}
		.step-en {
			grid-column: 2 / 8;
		}
		.step-zh {
			grid-column: 8 / 13;
		}
		.step-tick {
			display: none;
		}
	}

	@media (max-width: 60rem) {
		.proc-title {
			grid-column: 1 / -1;
		}
		.proc-side {
			grid-column: 1 / -1;
			text-align: left;
		}
	}

	@media (max-width: 40rem) {
		.step-num {
			grid-column: 1 / 3;
		}
		.step-en {
			grid-column: 3 / 13;
		}
		.step-zh {
			grid-column: 3 / 13;
		}
	}
</style>
