---
import { capabilities } from "../../lib/copy";
const run = [...capabilities];
---

<section class="mq" id="capabilities" aria-labelledby="mq-title">
	<h2 class="visually-hidden" id="mq-title">能力範圍 CAPABILITIES</h2>
	<span class="d01-rule d01-rule--heavy mq-cap" aria-hidden="true"></span>

	<div class="mq-band">
		<div class="mq-track">
			<ul class="mq-run">
				{
					run.map(term => (
						<li>
							{term}
							<span class="dot" aria-hidden="true" />
						</li>
					))
				}
			</ul>
			<ul class="mq-run" aria-hidden="true">
				{
					run.map(term => (
						<li>
							{term}
							<span class="dot" />
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<div class="mq-band mq-band--alt">
		<div class="mq-track mq-track--rev">
			<ul class="mq-run mq-run--small" aria-hidden="true">
				{run.map(term => <li>{term}</li>)}
			</ul>
			<ul class="mq-run mq-run--small" aria-hidden="true">
				{run.map(term => <li>{term}</li>)}
			</ul>
		</div>
	</div>

	<span class="d01-rule d01-rule--heavy mq-cap mq-cap--accent" aria-hidden="true"></span>
</section>

<style>
	.mq {
		overflow: clip;
	}
	.mq-cap {
		--rule-c: var(--graphite);
	}
	.mq-cap--accent {
		--rule-c: var(--orange);
	}

	.mq-band {
		overflow: clip;
		padding-block: clamp(0.875rem, 2vh, 1.5rem);
	}
	.mq-band--alt {
		border-top: 1px solid var(--rule-hair);
		background: color-mix(in oklab, var(--paper-hi) 50%, transparent);
	}

	.mq-track {
		display: flex;
		width: max-content;
		animation: d01-mq 46s linear infinite;
	}
	.mq-track--rev {
		animation-duration: 64s;
		animation-direction: reverse;
	}

	.mq-run {
		display: flex;
		align-items: center;
		flex: none;
	}
	.mq-run li {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 2.4vw, 2rem);
		padding-right: clamp(1rem, 2.4vw, 2rem);
		font-size: clamp(1.375rem, 3vw, 2.75rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		white-space: nowrap;
		line-height: 1.1;
		color: var(--ink-display);
	}
	.mq-run .dot {
		width: 0.4375rem;
		height: 0.4375rem;
		border-radius: 50%;
		background: var(--orange);
		flex: none;
	}
	.mq-run--small li {
		font-size: var(--label);
		font-weight: 500;
		letter-spacing: var(--tr-label);
		padding-right: clamp(1.25rem, 3vw, 2.5rem);
		gap: 0;
		color: var(--graphite);
	}

	@keyframes d01-mq {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mq-track {
			animation-name: none;
		}
	}
</style>
