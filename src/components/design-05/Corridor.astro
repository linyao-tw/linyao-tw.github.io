---
import { services } from "../../lib/copy";

/**
 * The corridor: six nested trapezoid planes. This is the one place in 05 that
 * implies depth — and it does it by nesting scaled 2D shapes with a graded
 * tone, never with perspective. Every ring's top and bottom edge is cut at
 * exactly 8°, because each ring's shear is derived from its own width.
 */
const RING_TONES = [
	"color-mix(in oklab, var(--warm-gray) 84%, var(--graphite))",
	"color-mix(in oklab, var(--warm-gray) 66%, var(--graphite))",
	"color-mix(in oklab, var(--warm-gray) 47%, var(--graphite))",
	"color-mix(in oklab, var(--warm-gray) 29%, var(--graphite))",
	"color-mix(in oklab, var(--warm-gray) 12%, var(--graphite))",
	"var(--void)"
];

const rings = RING_TONES.map((tone, i) => {
	const l = +(i * 5.6).toFixed(2);
	const r = +(i * 3.8).toFixed(2);
	const t = +(i * 4.6).toFixed(2);
	const b = +(i * 3.4).toFixed(2);
	const w = +(100 - l - r).toFixed(2);
	return { i, tone, style: `--rl:${l}vw;--rr:${r}vw;--rt:${t}svh;--rb:${b}svh;--rw:${w}vw;background:${tone}` };
});

const bays = services.items.map(item => ({ index: item.index, en: item.en, position: item.position }));

/* the lead sentence, hand-broken at the 的 rather than left to the browser */
const leadParts = [services.lead.slice(0, 20), services.lead.slice(20)];
---

<section class="services" id="services" aria-labelledby="d05-services-title">
	<div class="head" data-reveal>
		<p class="idx d05-anno" aria-hidden="true">0.03<br />SERVICES</p>

		<h2 class="d05-zh lead" id="d05-services-title">
			{leadParts.map(part => <span>{part}</span>)}
		</h2>

		<ul class="key">
			{
				bays.map(bay => (
					<li>
						<span class="key-i d05-anno">{bay.index}</span>
						<span class="key-en d05-latin">{bay.en}</span>
						<span class="key-zh d05-anno d05-anno--wrap">{bay.position}</span>
					</li>
				))
			}
		</ul>
	</div>

	<div class="corridor" data-scene aria-hidden="true">
		{
			rings.map(ring => (
				<div class={`ring ring-${ring.i}`} style={ring.style} data-ring data-par={ring.i === 0 ? "0" : String(-(ring.i * 0.9).toFixed(2))}>
					{ring.i === rings.length - 1 && <span class="light" />}
				</div>
			))
		}

		<svg class="marks" viewBox="0 0 200 120" preserveAspectRatio="none" focusable="false">
			<path d="M0 60 H200" stroke="currentColor" stroke-width="1" stroke-dasharray="6 5" vector-effect="non-scaling-stroke"></path>
		</svg>

		<p class="d05-anno callout callout-a">SECTION B&ndash;B</p>
		<p class="d05-anno callout callout-b">BAY 01 &rarr; 03</p>

		<div class="vdim">
			<span class="vdim-line"></span>
			<span class="d05-anno vdim-tag">4 200</span>
		</div>

		<div class="earth"></div>
	</div>

	<slot />
</section>

<style>
	.services {
		position: relative;
		background: var(--bg);
	}

	.head {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 38rem) 1fr;
		gap: clamp(1.25rem, 3vw, 3rem);
		align-items: start;
		padding: clamp(4rem, 12svh, 8rem) var(--gutter) clamp(2.5rem, 6svh, 4rem);
		border-top: 1px solid var(--line);
	}

	.idx {
		color: color-mix(in oklab, var(--graphite) 58%, transparent);
		line-height: 1.7;
	}

	.lead {
		font-size: clamp(1.0625rem, 1.7vw, 1.375rem);
		line-height: 1.9;
		letter-spacing: 0.08em;
		font-weight: 500;
	}

	.lead span:last-child {
		padding-left: 2.5em;
	}

	.key {
		display: grid;
		gap: 0.875rem;
		justify-self: end;
		max-width: 15rem;
		width: 100%;
	}

	.key li {
		display: grid;
		grid-template-columns: 1.75rem 1fr;
		gap: 0.375rem 0.625rem;
		padding-top: 0.5rem;
		border-top: 1px solid var(--line-soft);
	}

	.key-i {
		color: var(--graphite);
	}

	.key-en {
		font-size: 0.625rem;
		letter-spacing: 0.2em;
	}

	.key-zh {
		grid-column: 2;
		color: var(--graphite);
		letter-spacing: 0.1em;
	}

	/* ---------- the corridor ---------- */
	.corridor {
		--sh: 78svh;
		position: relative;
		height: var(--sh);
		overflow: clip;
		isolation: isolate;
	}

	.ring {
		position: absolute;
		left: var(--rl);
		right: var(--rr);
		top: var(--rt);
		bottom: var(--rb);
		/* 8° shear derived from this ring's own width — every ring parallel */
		clip-path: polygon(0 calc(var(--rw) * var(--tan-a)), 100% 0, 100% calc(100% - var(--rw) * var(--tan-a)), 0 100%);
		will-change: transform;
	}

	.ring-0 {
		z-index: 1;
	}
	.ring-1 {
		z-index: 2;
	}
	.ring-2 {
		z-index: 3;
	}
	.ring-3 {
		z-index: 4;
	}
	.ring-4 {
		z-index: 5;
	}
	.ring-5 {
		z-index: 6;
	}

	/* the light at the end of the corridor — an echo of the disc.
	   It lives inside the deepest ring, so it is carried and clipped by it
	   at every breakpoint. */
	.light {
		position: absolute;
		left: 42%;
		top: 29%;
		width: 4.5%;
		height: 52%;
		background: var(--orange);
	}

	.marks {
		position: absolute;
		inset: 0;
		z-index: 8;
		width: 100%;
		height: 100%;
		color: color-mix(in oklab, var(--graphite) 26%, transparent);
	}

	.callout {
		position: absolute;
		z-index: 9;
	}

	.callout-a {
		left: var(--gutter);
		top: 2.25rem;
		color: color-mix(in oklab, var(--graphite) 70%, transparent);
	}

	.callout-b {
		left: var(--gutter);
		bottom: 8svh;
		color: color-mix(in oklab, var(--graphite) 70%, transparent);
	}

	.vdim {
		position: absolute;
		z-index: 9;
		right: calc(var(--gutter) * 0.6);
		top: 24svh;
		height: 30svh;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.vdim-line {
		position: relative;
		width: 1px;
		height: 100%;
		background: var(--line);
	}

	.vdim-line::before,
	.vdim-line::after {
		content: "";
		position: absolute;
		left: -0.3125rem;
		width: 0.6875rem;
		height: 1px;
		background: var(--line);
	}

	.vdim-line::before {
		top: 0;
	}

	.vdim-line::after {
		bottom: 0;
	}

	.vdim-tag {
		writing-mode: vertical-rl;
		color: color-mix(in oklab, var(--graphite) 58%, transparent);
	}

	/* ground / earth hatch under the corridor */
	.earth {
		position: absolute;
		z-index: 10;
		inset: auto 0 0;
		height: 5.5svh;
		border-top: 1px solid var(--line);
		background: var(--hatch-b);
	}

	@media (max-width: 64rem) {
		.head {
			grid-template-columns: 3.5rem minmax(0, 1fr);
		}

		.key {
			grid-column: 2;
			justify-self: start;
			max-width: none;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1rem;
			margin-top: 1.5rem;
		}

		.corridor {
			--sh: 62svh;
		}

		.vdim {
			top: 20svh;
			height: 24svh;
		}
	}

	@media (max-width: 48rem) {
		.corridor {
			--sh: 52svh;
		}

		.vdim {
			display: none;
		}
	}

	@media (max-width: 30rem) {
		.head {
			grid-template-columns: 1fr;
			gap: 1.25rem;
			padding-top: 3.5rem;
		}

		.idx {
			border-left: 1px solid var(--line);
			padding-left: 0.625rem;
		}

		.lead {
			font-size: 0.9375rem;
			letter-spacing: 0.04em;
		}

		.lead span:last-child {
			padding-left: 1.25em;
		}

		.key {
			grid-column: 1;
			grid-template-columns: 1fr;
		}

		.corridor {
			--sh: 46svh;
		}

		/* fewer planes at 390 — the two outermost rings are dropped and the
		   corridor is cropped tighter around the light */
		.ring-0,
		.ring-1 {
			display: none;
		}

		.ring-2 {
			left: 0;
			right: 0;
			top: 0;
			bottom: 0;
			--rw: 100vw;
		}

		.ring-3 {
			left: 6vw;
			right: 4vw;
			top: 4svh;
			bottom: 3svh;
			--rw: 90vw;
		}

		.ring-4 {
			left: 14vw;
			right: 9vw;
			top: 9svh;
			bottom: 7svh;
			--rw: 77vw;
		}

		.ring-5 {
			left: 24vw;
			right: 16vw;
			top: 15svh;
			bottom: 11svh;
			--rw: 60vw;
		}

		.callout-b {
			bottom: 6svh;
		}

		.earth {
			height: 4svh;
		}
	}
</style>
