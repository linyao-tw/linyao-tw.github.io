---
import { brand, nav } from "../../lib/copy";
import { vRibbon, waveRule } from "./geo";

const tailCentre = (t: number) => 150 - 80 * Math.pow(t, 1.3) + 14 * Math.sin(t * Math.PI * 1.6);
const tail = vRibbon({ height: 258, samples: 48, centre: tailCentre, width: t => 26 - 9 * t });
const endX = tailCentre(1);

const rule = waveRule({
	width: 1000,
	base: 14,
	layers: [
		{ amp: 6, freq: 2.6, phase: 1.9 },
		{ amp: 2.4, freq: 5.4, phase: 3.8 }
	],
	samples: 72
});
---

<footer class="ft">
	<div class="cap" aria-hidden="true"></div>

	<svg class="tail" viewBox="0 0 200 320" aria-hidden="true" focusable="false">
		<path class="tf" d={tail.fill}></path>
		<path class="te" d={tail.fill} vector-effect="non-scaling-stroke"></path>
		<circle class="tdot" cx={endX.toFixed(2)} cy="276" r="17"></circle>
		<circle class="tring" cx={endX.toFixed(2)} cy="276" r="31" vector-effect="non-scaling-stroke"></circle>
	</svg>

	<div class="wrap">
		<div class="mark">
			<p class="en">{brand.nameEn}</p>
			<p class="zh">{brand.nameZh}</p>
			<p class="eq">{brand.equation}</p>
		</div>

		<nav class="links" aria-label="頁尾導覽">
			<ul>
				{
					nav.map(n => (
						<li>
							<a href={n.href}>
								<span>{n.label}</span>
								<span class="z">{n.zh}</span>
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="contact">
			<p class="lbl">EMAIL</p>
			<p class="mail"><a href={`mailto:${brand.email}`}>{brand.email}</a></p>
		</div>

		<svg class="rule" viewBox="0 0 1000 28" preserveAspectRatio="none" aria-hidden="true" focusable="false">
			<path d={rule} vector-effect="non-scaling-stroke"></path>
		</svg>

		<div class="base">
			<p>{brand.copyright}</p>
			<a class="top" href="#main">BACK TO TOP <span aria-hidden="true">↑</span></a>
		</div>
	</div>
</footer>

<style>
	.ft {
		position: relative;
		background: var(--wg);
		padding: clamp(5rem, 12vh, 9rem) 0 clamp(2rem, 5vh, 3.5rem);
	}

	.cap {
		position: absolute;
		top: calc(-1 * clamp(3rem, 8vw, 8rem));
		left: 0;
		right: 0;
		height: clamp(3rem, 8vw, 8rem);
		background: var(--wg);
		clip-path: ellipse(66% 100% at 50% 100%);
	}

	.tail {
		position: absolute;
		top: calc(-1 * clamp(2rem, 5vw, 5rem));
		right: clamp(1rem, 8vw, 10rem);
		width: clamp(7rem, 13vw, 12.5rem);
		height: auto;
		pointer-events: none;
	}

	.tf,
	.tdot {
		fill: var(--orange);
	}

	.te,
	.tring {
		fill: none;
		stroke: var(--ink-black);
		stroke-width: 1;
		opacity: 0.32;
	}

	.wrap {
		position: relative;
		z-index: 2;
		padding-inline: var(--pad);
		display: grid;
		gap: clamp(2.5rem, 6vh, 4.5rem);
	}

	.mark .en {
		font-family: var(--font-serif);
		font-size: clamp(1.8rem, 5.4vw, 4.6rem);
		line-height: 1.1;
		letter-spacing: 0.06em;
	}

	.mark .zh {
		font-family: var(--font-serif);
		font-size: clamp(1rem, 1.5vw, 1.45rem);
		letter-spacing: 0.3em;
		margin-top: 0.7rem;
	}

	.mark .eq {
		font-size: var(--meta);
		letter-spacing: 0.34em;
		color: var(--ink-2);
		margin-top: 1.1rem;
	}

	.links ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem clamp(1.5rem, 4vw, 3.5rem);
	}

	.links a {
		display: inline-flex;
		align-items: baseline;
		gap: 0.55rem;
		min-height: 2.75rem;
		font-size: var(--meta);
		letter-spacing: 0.22em;
		color: var(--ink-2);
	}

	.links a:hover,
	.links a:focus-visible {
		color: var(--fg);
	}

	.links .z {
		font-family: var(--font-serif);
		letter-spacing: 0.14em;
	}

	.contact {
		display: grid;
		gap: 0.6rem;
	}

	.lbl {
		font-size: 0.62rem;
		letter-spacing: 0.32em;
		color: var(--ink-2);
	}

	.mail a {
		font-family: var(--font-serif);
		font-size: clamp(1.15rem, 2.4vw, 2.1rem);
		letter-spacing: 0.08em;
		border-bottom: 1px solid var(--line);
		padding-bottom: 0.25rem;
	}

	.mail a:hover,
	.mail a:focus-visible {
		border-color: var(--orange);
		color: var(--orange);
	}

	.rule {
		width: 100%;
		height: 1.75rem;
		fill: none;
		stroke: var(--line-soft);
		stroke-width: 1;
	}

	.base {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem 2rem;
		font-size: var(--meta);
		letter-spacing: 0.2em;
		color: var(--ink-2);
	}

	.top {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
	}

	.top:hover,
	.top:focus-visible {
		color: var(--orange);
	}
</style>
