---
import { smoothD, type Pt } from "./geo";

type Item = {
	index: string;
	en: string;
	zh: string;
	position: string;
	body: readonly string[];
	stack: readonly string[];
};

interface Props {
	item: Item;
	variant: 1 | 2 | 3;
}

const { item, variant } = Astro.props;

const n = item.stack.length;
const curve = (t: number) => {
	if (variant === 1) return Math.sin(t * Math.PI) * 5.6;
	if (variant === 2) return (1 - Math.sin(t * Math.PI)) * 4.8;
	return Math.pow(t, 1.6) * 7.2;
};

const offsets = item.stack.map((_, i) => curve(n > 1 ? i / (n - 1) : 0));
const maxOff = Math.max(...offsets, 0.001);
const guide: Pt[] = offsets.map((o, i) => [(o / maxOff) * 10, ((i + 0.5) / n) * 100]);
const guideD = smoothD(guide);
---

<article class={`band v${variant}`} aria-labelledby={`d09-svc-${item.index}`}>
	<div class="ground" aria-hidden="true"></div>

	{
		variant === 1 && (
			<svg class="deco d1" viewBox="0 -22 1000 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
				<use href="#d09-ridge-a" />
			</svg>
		)
	}
	{
		variant === 2 && (
			<svg class="deco d2" viewBox="-380 -430 760 860" aria-hidden="true" focusable="false">
				<use href="#d09-peak-b" />
			</svg>
		)
	}
	{
		variant === 3 && (
			<svg class="deco d3" viewBox="-320 -260 640 520" aria-hidden="true" focusable="false">
				<use href="#d09-peak-a" />
			</svg>
		)
	}

	<div class="wrap">
		<p class="num" aria-hidden="true">{item.index}</p>

		<div class="head">
			<h3 class="zh" id={`d09-svc-${item.index}`}>{item.zh}</h3>
			<p class="en">{item.en}</p>
			<p class="pos">＝{item.position}</p>
		</div>

		<div class="text">
			{item.body.map(line => <p>{line}</p>)}
		</div>

		<div class="stackwrap">
			<svg class="guide" viewBox="0 0 10 100" preserveAspectRatio="none" aria-hidden="true" focusable="false" style={`width:${maxOff.toFixed(2)}rem`}>
				<path d={guideD} vector-effect="non-scaling-stroke"></path>
			</svg>
			<ul class="stack">
				{
					item.stack.map((s, i) => (
						<li style={`--o:${offsets[i].toFixed(2)}rem`}>
							<span class="dot" aria-hidden="true" />
							{s}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</article>

<style>
	.band {
		position: relative;
		padding-block: clamp(5rem, 12vh, 10rem);
	}

	.ground {
		position: absolute;
		inset: 0;
		z-index: -1;
	}

	.v1 .ground {
		background: var(--band-a);
		clip-path: var(--arc-top);
	}

	.v2 .ground {
		inset: 0 clamp(0.75rem, 5vw, 7rem);
		background: var(--band-c);
		clip-path: var(--arc-both-deep);
	}

	.v3 .ground {
		background: var(--band-d);
		clip-path: var(--arc-bottom);
	}

	.v2 {
		margin-block: clamp(3rem, 7vh, 6rem);
		padding-block: clamp(7rem, 15vh, 12rem);
	}

	.deco {
		position: absolute;
		z-index: 0;
		fill: none;
		stroke: var(--line-soft);
		pointer-events: none;
	}

	.d1 {
		inset: auto 0 -4% 0;
		width: 100%;
		height: 48%;
		opacity: 0.85;
	}

	.d2 {
		width: 40%;
		aspect-ratio: 760 / 860;
		right: 4%;
		top: -8%;
		opacity: 0.7;
	}

	.d3 {
		width: 46%;
		aspect-ratio: 640 / 520;
		left: -12%;
		bottom: -10%;
		opacity: 0.55;
	}

	.wrap {
		position: relative;
		z-index: 2;
		padding-inline: var(--pad);
		display: grid;
		gap: clamp(1.5rem, 3vw, 2.75rem) clamp(2rem, 5vw, 5rem);
	}

	.num {
		font-family: var(--font-serif);
		line-height: 0.78;
		color: var(--orange);
		font-size: clamp(5rem, 16vw, 15rem);
		letter-spacing: -0.03em;
	}

	.zh {
		font-family: var(--font-serif);
		font-size: var(--dsp-2);
		letter-spacing: 0.14em;
		line-height: 1.3;
	}

	.en {
		font-size: clamp(0.7rem, 0.95vw, 0.88rem);
		letter-spacing: 0.42em;
		color: var(--fg);
		margin-top: 0.8rem;
	}

	.pos {
		font-family: var(--font-serif);
		font-size: clamp(0.95rem, 1.2vw, 1.2rem);
		letter-spacing: 0.1em;
		margin-top: 1.1rem;
	}

	.text p {
		font-family: var(--font-serif);
		font-size: var(--copy);
		line-height: 2.15;
		letter-spacing: 0.08em;
		max-width: 34rem;
	}

	.stackwrap {
		position: relative;
	}

	.guide {
		position: absolute;
		inset-block: 0;
		inset-inline-start: 0;
		height: 100%;
		fill: none;
		stroke: var(--orange);
		stroke-width: 1;
	}

	.stack {
		display: grid;
	}

	.stack li {
		margin-inline-start: var(--o);
		min-height: 2.25rem;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		font-size: var(--meta);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--fg);
	}

	.dot {
		width: 0.3rem;
		height: 0.3rem;
		border-radius: 50%;
		background: var(--orange);
		flex: none;
	}

	/* --- 01 web: numeral cropped at the left edge, content pushed right --- */
	.v1 .wrap {
		grid-template-columns: minmax(0, auto) minmax(0, 1fr) minmax(0, 18rem);
		align-items: start;
	}

	.v1 .num {
		margin-inline-start: calc(var(--pad) * -1 - 0.12em);
		grid-row: span 2;
	}

	.v1 .head {
		grid-column: 2;
	}

	.v1 .stackwrap {
		grid-column: 3;
		grid-row: span 2;
		padding-top: 1rem;
	}

	.v1 .text {
		grid-column: 2;
	}

	/* --- 02 system: island band, ringed numeral on the right --- */
	.v2 .wrap {
		grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
		max-width: 78rem;
		margin-inline: auto;
		align-items: start;
	}

	.v2 .head {
		grid-column: 1;
	}

	.v2 .num {
		grid-column: 2;
		grid-row: 1 / span 2;
		justify-self: center;
		font-size: clamp(3.5rem, 7vw, 6.5rem);
		color: var(--fg);
		display: grid;
		place-items: center;
		width: clamp(9rem, 17vw, 15rem);
		aspect-ratio: 1;
		border: 1px solid var(--line);
		border-radius: 50%;
		line-height: 1;
	}

	.v2 .text {
		grid-column: 1;
	}

	.v2 .stackwrap {
		grid-column: 1 / -1;
		border-top: 1px solid var(--line-soft);
		padding-top: 1.5rem;
	}

	.v2 .stack li {
		letter-spacing: 0.3em;
		min-height: 2.6rem;
	}

	.v2 .guide {
		stroke: var(--line);
	}

	/* --- 03 creative: numeral sits inside a disc, title overlaps it --- */
	.v3 .wrap {
		grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
		align-items: end;
	}

	.v3 .num {
		grid-column: 1;
		grid-row: 1;
		justify-self: start;
		display: grid;
		place-items: center;
		width: clamp(8rem, 15vw, 13rem);
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--orange);
		color: var(--ink-black);
		font-size: clamp(3rem, 6vw, 5.5rem);
		line-height: 1;
	}

	.v3 .head {
		grid-column: 1;
		grid-row: 1;
		align-self: center;
		margin-inline-start: clamp(6rem, 12vw, 11rem);
		margin-top: clamp(4rem, 9vw, 8rem);
	}

	.v3 .text {
		grid-column: 1;
		grid-row: 2;
	}

	.v3 .stackwrap {
		grid-column: 2;
		grid-row: 1 / span 2;
		align-self: center;
	}

	@media (max-width: 60rem) {
		.v1 .wrap,
		.v2 .wrap,
		.v3 .wrap {
			grid-template-columns: minmax(0, 1fr);
		}

		.v1 .num,
		.v2 .num,
		.v3 .num,
		.v1 .head,
		.v2 .head,
		.v3 .head,
		.v1 .text,
		.v2 .text,
		.v3 .text,
		.v1 .stackwrap,
		.v2 .stackwrap,
		.v3 .stackwrap {
			grid-column: 1;
			grid-row: auto;
		}

		.v1 .num {
			margin-inline-start: calc(var(--pad) * -1 - 0.12em);
		}

		.v3 .head {
			margin-inline-start: 0;
			margin-top: 0;
		}

		.v2 .num {
			justify-self: start;
		}
	}
</style>
