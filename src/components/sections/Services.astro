---
import { services } from "../../lib/copy";
import ServiceRow from "./ServiceRow.astro";

const leadParts = ["我們提供涵蓋視覺、品牌、", "網站與技術開發的", "完整數位設計服務。"];

const rows = [
	{ item: services.items[0], variant: "a" as const, nameLines: ["WEB DEVELOPMENT"] },
	{ item: services.items[1], variant: "b" as const, nameLines: ["SYSTEM", "DEVELOPMENT"] },
	{ item: services.items[2], variant: "c" as const, nameLines: ["CREATIVE", "DEVELOPMENT"] }
];
---

<section class="svc" id="services" aria-labelledby="ly-svc-h">
	<div class="lead">
		<h2 class="lead-h" id="ly-svc-h" aria-label={services.lead} data-ly-lines>
			<span class="ln l1"><span class="ly-li">{leadParts[0]}</span></span>
			<span class="ln l2"><span class="ly-li">{leadParts[1]}</span></span>
			<span class="ln l3"><span class="ly-li">{leadParts[2]}</span></span>
		</h2>
	</div>

	<div class="dense">
		<span class="d-r" aria-hidden="true"></span>
		{
			services.items.map(s => (
				<span class="d-i">
					<b>{s.index}</b>
					<i>{s.position}</i>
				</span>
			))
		}
	</div>

	<div class="run ly-run">
		{rows.map((r, i) => <ServiceRow item={r.item} variant={r.variant} nameLines={r.nameLines} i={i} />)}
	</div>
</section>

<style>
	.svc {
		position: relative;
	}

	.lead {
		padding: clamp(4rem, 12vh, 8rem) var(--edge) clamp(2.5rem, 7vh, 4.5rem);
		overflow: clip;
	}

	.lead-h {
		display: grid;
		font-family: var(--font-cjk);
		font-weight: 700;
		color: var(--ink);
	}

	.ln {
		display: block;
		overflow: clip;
		/* Noto Sans TC's font box is 1.45em (asc 1.160 + desc 0.290) and its ink
		   sits low in it, so at these line-heights the glyph overflows the line
		   box by up to 0.148em below. Pad the clip box past that and cancel the
		   padding with an equal negative margin so layout is unchanged. */
		padding-block: 0.16em;
		margin-block: -0.16em;
	}

	.ln .ly-li {
		display: block;
		line-height: 0.95;
		white-space: nowrap;
		will-change: transform;
	}

	.l1 {
		font-size: clamp(1.15rem, 4vw, 2.9rem);
	}

	.l1 .ly-li {
		letter-spacing: 0.08em;
		color: var(--dim);
	}

	.l2 {
		font-size: clamp(2rem, 8.4vw, 6.5rem);
	}

	.l2 .ly-li {
		letter-spacing: -0.02em;
		margin-inline-start: -0.04em;
	}

	.l3 {
		font-size: clamp(0.9rem, 2.6vw, 1.9rem);
	}

	.l3 .ly-li {
		letter-spacing: 0.24em;
		color: var(--dim);
	}

	.l3 {
		/* hangs off the left edge like the lines above it, tabbed in */
		justify-self: start;
		margin-inline-start: 2.6em;
		margin-block-start: 0.75rem;
	}

	/* --- dense running band ------------------------------------------- */
	.dense {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.5rem;
		padding: 0.7rem var(--edge);
		border-block: var(--hairline) solid var(--rule);
		font-family: var(--font-mono);
		font-size: 0.58rem;
		letter-spacing: 0.24em;
		color: var(--dim);
	}

	.d-r {
		flex: 1 1 2rem;
		height: 1px;
		background: var(--rule);
	}

	.d-i {
		display: inline-flex;
		align-items: baseline;
		gap: 0.55rem;
	}

	.d-i b {
		font-weight: 400;
		color: var(--accent-txt);
	}

	.d-i i {
		font-family: var(--font-cjk);
		font-style: normal;
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		color: var(--quiet);
	}

	.d-end {
		margin-inline-start: auto;
	}

	.run {
		position: relative;
	}

	@media (max-width: 48rem) {
		.dense {
			gap: 0.4rem 1rem;
		}

		.d-r,
		.d-end {
			display: none;
		}
	}
</style>
