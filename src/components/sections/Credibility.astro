---
import { awards, manifesto } from "../../lib/copy";

/** specimen sizes — a real type specimen sets each string to a different body size */
/** a Han figure (十年) carries more ink per em than a Latin one, so it is set
   smaller and nudged up — its glyphs sit lower than the Latin baseline */
const isHan = (s: string) => /\p{Script=Han}/u.test(s);

const sizes = [
	{ d: "clamp(3rem, 11vw, 9rem)", m: "clamp(2.75rem, 14vw, 4rem)" },
	{ d: "clamp(2rem, 7.6vw, 6rem)", m: "clamp(2rem, 11vw, 3rem)" },
	{ d: "clamp(1.15rem, 4.3vw, 3.4rem)", m: "clamp(1.15rem, 6.4vw, 1.8rem)" }
];
---

<section class="cred" aria-labelledby="ly-cred-h">
	<h2 class="side" id="ly-cred-h">實績</h2>

	<div class="specs">
		<span class="baseline" aria-hidden="true"></span>
		{
			manifesto.credibility.map((c, i) => (
				<Fragment>
					<span class:list={["fig", { han: isHan(c.figure) }]} style={`--fs:${sizes[i].d}; --fs-m:${sizes[i].m}; --c:${i + 1}`}>
						{c.figure}
					</span>
					<div class="meta" style={`--c:${i + 1}`}>
						<h3 class="lab" lang="zh-Hant">
							{c.label}
						</h3>
					</div>
				</Fragment>
			))
		}
	</div>

	<div class="awards">
		<h3 class="sub" id="ly-awards-h">
			<span lang="zh-Hant">{awards.title}</span>
			<span class="count" aria-hidden="true">{String(awards.items.length).padStart(2, "0")}</span>
		</h3>
		<ul class="list" aria-labelledby="ly-awards-h">
			{
				awards.items.map(a => (
					<li class="award">
						<span class="org">{a.org}</span>
						<span class="title">{a.title}</span>
						<span class="yr">{a.year}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.cred {
		position: relative;
		padding: clamp(3rem, 9vh, 6rem) var(--edge) clamp(3rem, 9vh, 5rem);
		border-top: var(--hairline) solid var(--rule);
		overflow: clip;
	}

	.side {
		font-family: var(--font-mono);
		font-size: var(--fs-min);
		letter-spacing: 0.34em;
		color: var(--accent-txt);
		margin-block-end: 0.75rem;
	}

	.head {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding-block-end: clamp(1.5rem, 5vh, 3rem);
		font-family: var(--font-mono);
		font-size: var(--fs-min);
		letter-spacing: 0.24em;
		color: var(--dim);
	}

	.hr {
		flex: 1;
		height: 1px;
		background: var(--rule-soft);
	}

	.specs {
		display: grid;
		gap: 0.5rem;
	}

	.baseline {
		display: none;
	}

	.fig {
		font-family: var(--font-grotesk);
		font-weight: 800;
		font-size: var(--fs-m);
		line-height: 0.74;
		letter-spacing: -0.045em;
		color: var(--ink);
	}

	.fig.han {
		font-family: var(--font-cjk);
		letter-spacing: 0;
	}

	.meta {
		display: grid;
		gap: 0.3rem;
		padding-block-end: 1.1rem;
		margin-block-end: 0.6rem;
		border-bottom: var(--hairline) solid var(--rule-soft);
	}

	.lab {
		font-family: var(--font-cjk);
		font-size: clamp(var(--fs-min), 2.6vw, 1.25rem);
		font-weight: 600;
		letter-spacing: 0.1em;
		color: var(--ink);
	}

	.en {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 0.9rem;
		font-family: var(--font-mono);
		font-size: var(--fs-min);
		letter-spacing: 0.2em;
		color: var(--dim);
	}

	.ref {
		color: var(--accent-txt);
	}

	/* --- awards: compact ruled list ------------------------------------ */
	.awards {
		display: grid;
		gap: 1rem;
		margin-block-start: clamp(2.5rem, 8vh, 5rem);
	}

	.sub {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		font-family: var(--font-cjk);
		font-size: var(--fs-min);
		font-weight: 600;
		letter-spacing: 0.24em;
		color: var(--ink);
	}

	.count {
		font-family: var(--font-mono);
		font-weight: 400;
		letter-spacing: 0.1em;
		color: var(--accent-txt);
	}

	.list {
		border-block: var(--hairline) solid var(--rule);
	}

	.award {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		column-gap: 1rem;
		row-gap: 0.1rem;
		padding-block: 0.7rem;
		font-size: var(--fs-min);
		line-height: 1.45;
	}

	.award + .award {
		border-top: var(--hairline) solid var(--rule-soft);
	}

	.org {
		font-weight: 700;
		color: var(--ink);
	}

	.title {
		grid-row: 2;
		color: var(--dim);
	}

	.yr {
		font-family: var(--font-mono);
		letter-spacing: 0.1em;
		color: var(--dim);
	}

	@media (min-width: 48rem) {
		.award {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) auto;
			align-items: baseline;
		}

		.title {
			grid-row: auto;
		}
	}

	@media (min-width: 62rem) {
		.cred {
			padding-inline-start: calc(var(--edge) + 3.5rem);
		}

		.side {
			position: absolute;
			top: clamp(3rem, 9vh, 6rem);
			left: var(--edge);
			writing-mode: vertical-rl;
			margin: 0;
		}

		.specs {
			grid-template-columns: repeat(3, minmax(0, auto));
			grid-template-rows: auto auto;
			justify-content: space-between;
			align-items: end;
			column-gap: clamp(1.5rem, 4vw, 4rem);
			row-gap: 1.1rem;
		}

		.baseline {
			display: block;
			grid-row: 1;
			grid-column: 1 / -1;
			align-self: end;
			height: 1px;
			background: var(--ink);
		}

		.fig {
			grid-row: 1;
			grid-column: var(--c);
			align-self: end;
			font-size: var(--fs);
			white-space: nowrap;
		}

		.fig.han {
			translate: 0 -0.1em;
		}

		.meta {
			grid-row: 2;
			grid-column: var(--c);
			max-width: 17rem;
			border-bottom: 0;
			padding-block-end: 0;
			margin-block-end: 0;
		}

		.lab {
			font-size: clamp(var(--fs-min), 1.15vw, 1.25rem);
		}

		.awards {
			grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr);
			column-gap: clamp(1.5rem, 4vw, 4rem);
			align-items: start;
		}

		.sub {
			padding-block-start: 0.7rem;
		}
	}
</style>
