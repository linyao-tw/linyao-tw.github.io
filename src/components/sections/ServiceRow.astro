---
interface Props {
	item: {
		index: string;
		en: string;
		zh: string;
		position: string;
		body: readonly string[];
		stack: readonly string[];
	};
	variant: "a" | "b" | "c";
	nameLines: string[];
	i: number;
}

const { item, variant, nameLines, i } = Astro.props;
const headingId = `ly-svc-${item.index}`;
---

<article class:list={["row", `v-${variant}`]} style={`--i:${i}`} aria-labelledby={headingId}>
	<div class="crop ly-glyph-crop" aria-hidden="true">
		<div class="gtrack ly-glyph-track"><span class="g">體</span></div>
	</div>

	<p class="idx" aria-hidden="true"><span class="idx-n">{item.index}</span></p>

	<h3 class="name" id={headingId} aria-label={item.en}>
		{
			nameLines.map(word => (
				<span class="nl">
					<span class="stackword">
						<span class="ol">{word}</span>
						<span class="fl ly-fill" aria-hidden="true">
							{word}
						</span>
					</span>
				</span>
			))
		}
	</h3>

	<p class="zh" lang="zh-Hant">{item.zh}</p>

	<p class="pos" lang="zh-Hant"><span class="pos-tick" aria-hidden="true"></span>{item.position}</p>

	<p class="body" lang="zh-Hant">{item.body.map(line => <span class="bl">{line}</span>)}</p>

	<ul class="tstack">
		{item.stack.map(s => <li>{s}</li>)}
	</ul>
</article>

<style>
	.row {
		position: relative;
		overflow: clip;
		display: grid;
		gap: clamp(1rem, 2.5vh, 1.75rem);
		padding: clamp(3.5rem, 11vh, 7rem) var(--edge);
		border-top: var(--hairline) solid var(--rule);
		--nm: 13vw;
	}

	/* --- the travelling glyph window ---------------------------------- */
	.crop {
		position: absolute;
		inset-inline: 0;
		inset-block-start: calc(var(--i) * -100%);
		height: 300%;
		container-type: size;
		display: grid;
		place-items: center;
		pointer-events: none;
		user-select: none;
		z-index: 0;
	}

	.gtrack {
		will-change: transform;
		line-height: 0;
	}

	.g {
		display: block;
		font-family: var(--font-cjk);
		font-weight: 700;
		font-size: min(94cqh, 150vw);
		line-height: 0.84;
		color: var(--ghost);
	}

	.row > :not(.crop) {
		position: relative;
		z-index: 1;
	}

	/* --- index --------------------------------------------------------- */
	.idx {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		font-family: var(--font-mono);
		color: var(--dim);
	}

	.idx-n {
		font-size: 0.9rem;
		letter-spacing: 0.06em;
		color: var(--accent-txt);
	}

	.idx-l {
		font-size: 0.55rem;
		letter-spacing: 0.28em;
	}

	/* --- the name ------------------------------------------------------ */
	.name {
		display: grid;
		font-family: var(--font-grotesk);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 0.84;
		font-size: var(--nm);
	}

	.nl {
		display: block;
	}

	.stackword {
		position: relative;
		display: inline-block;
		white-space: nowrap;
	}

	.ol {
		display: block;
		color: transparent;
		-webkit-text-stroke: 0.012em var(--ink);
	}

	.fl {
		position: absolute;
		inset-block-start: 0;
		inset-inline-start: 0;
		display: block;
		color: var(--ink);
		/* same stroke as the outline copy so the solid state covers it exactly */
		-webkit-text-stroke: 0.012em currentColor;
		clip-path: inset(0% 0% 0% 0%);
		will-change: clip-path;
	}

	/* --- CJK name ------------------------------------------------------ */
	.zh {
		font-family: var(--font-cjk);
		font-weight: 700;
		font-size: clamp(1.5rem, 4.6vw, 3.25rem);
		letter-spacing: 0.1em;
		line-height: 1;
		color: var(--ink);
	}

	.pos {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-cjk);
		font-size: clamp(0.75rem, 1vw, 0.86rem);
		letter-spacing: 0.16em;
		color: var(--dim);
	}

	.pos-tick {
		flex: none;
		width: 1.5rem;
		height: 1px;
		background: var(--accent);
	}

	.body {
		display: grid;
		gap: 0.1rem;
		max-width: 26rem;
		font-family: var(--font-cjk);
		font-size: clamp(0.8rem, 1vw, 0.9rem);
		line-height: 2;
		letter-spacing: 0.05em;
		color: var(--quiet);
	}

	.bl {
		display: block;
	}

	.tstack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.1rem;
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--dim);
	}

	.tstack li {
		position: relative;
		padding-inline-start: 0.85rem;
	}

	.tstack li::before {
		content: "";
		position: absolute;
		inset-block-start: 0.42em;
		inset-inline-start: 0;
		width: 0.4rem;
		height: 1px;
		background: var(--rule);
	}

	/* --- 03 is the orange row at every breakpoint --------------------- */
	.v-c .ol {
		-webkit-text-stroke-color: var(--accent);
	}

	.v-c .fl {
		color: var(--accent);
	}

	.v-c .zh {
		color: var(--accent);
	}

	@media (max-width: 61.99rem) {
		/* below the desktop breakpoint the run is too tall for one glyph to span —
		   each row keeps its own hard crop of the same character instead */
		.crop {
			inset-block-start: 0;
			height: 100%;
		}

		.g {
			font-size: min(150cqh, 138vw);
		}

		.row {
			--nm: 12vw;
		}

		/* 01 is set on a single 15-character line — it needs a smaller body */
		.v-a {
			--nm: 8vw;
		}

		/* 02 stays right-hung, 03 stays stepped — the three never read alike */
		.v-b .idx,
		.v-b .pos {
			justify-content: flex-end;
		}

		.v-b .name {
			justify-items: end;
			text-align: end;
		}

		.v-b .zh,
		.v-b .body {
			text-align: end;
			justify-items: end;
			justify-self: end;
		}

		.v-b .tstack {
			justify-content: flex-end;
		}

		.v-c .name .nl:last-child {
			margin-inline-start: 7vw;
		}

		.v-c .tstack {
			padding-block-start: 1rem;
			border-top: var(--hairline) solid var(--rule);
		}
	}

	/* ================= desktop compositions ========================== */
	@media (min-width: 62rem) {
		/* --- 01 WEB DEVELOPMENT: one full-bleed line, split base -------- */
		.v-a {
			--nm: 8.9vw;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			grid-template-areas:
				"idx  idx"
				"name name"
				"zh   body"
				"pos  stack";
			column-gap: clamp(2rem, 6vw, 6rem);
			row-gap: clamp(1.25rem, 3vh, 2.25rem);
		}

		.v-a .idx {
			grid-area: idx;
		}

		.v-a .name {
			grid-area: name;
			margin-inline-start: 2.5vw;
		}

		.v-a .zh {
			grid-area: zh;
			padding-block-start: 1.25rem;
			border-top: var(--hairline) solid var(--rule);
		}

		.v-a .pos {
			grid-area: pos;
		}

		.v-a .body {
			grid-area: body;
			padding-block-start: 1.25rem;
			border-top: var(--hairline) solid var(--rule);
		}

		.v-a .tstack {
			grid-area: stack;
			align-content: start;
		}

		/* --- 02 SYSTEM / DEVELOPMENT: right-aligned, bleeds right ------ */
		.v-b {
			--nm: 12.5vw;
			grid-template-columns: auto minmax(0, 1fr);
			grid-template-areas:
				"zh  idx"
				"zh  name"
				"zh  pos"
				"zh  body"
				"zh  stack";
			column-gap: clamp(2rem, 5vw, 4.5rem);
			row-gap: clamp(0.9rem, 2.2vh, 1.6rem);
			align-items: start;
		}

		.v-b .zh {
			grid-area: zh;
			writing-mode: vertical-rl;
			align-self: stretch;
			font-size: clamp(2rem, 4.4vw, 3.5rem);
			letter-spacing: 0.24em;
			border-inline-start: var(--hairline) solid var(--rule);
			padding-inline-start: 1rem;
		}

		.v-b .idx {
			grid-area: idx;
			justify-content: flex-end;
		}

		.v-b .name {
			grid-area: name;
			justify-items: end;
			text-align: end;
		}

		.v-b .name .nl:last-child {
			margin-inline-end: -7vw;
		}

		.v-b .pos {
			grid-area: pos;
			justify-content: flex-end;
			padding-block-start: 1.25rem;
		}

		.v-b .body {
			grid-area: body;
			justify-self: end;
			text-align: end;
			justify-items: end;
		}

		.v-b .tstack {
			grid-area: stack;
			flex-direction: column;
			align-items: flex-end;
			gap: 0.3rem;
			padding-block-start: 1rem;
			border-top: var(--hairline) solid var(--rule);
			margin-inline-start: auto;
			min-width: 12rem;
		}

		.v-b .tstack li {
			padding-inline: 0.85rem 0;
		}
	}

	@media (min-width: 62rem) {
		/* --- 03 CREATIVE / DEVELOPMENT: stepped, orange ----------------- */
		.v-c {
			--nm: 12vw;
			grid-template-columns: minmax(0, 1fr) auto;
			grid-template-areas:
				"idx   pos"
				"name1 name1"
				"zh    body"
				"stack stack";
			column-gap: clamp(2rem, 5vw, 5rem);
			row-gap: clamp(1rem, 2.5vh, 1.75rem);
			align-items: end;
		}

		.v-c .idx {
			grid-area: idx;
		}

		.v-c .pos {
			grid-area: pos;
			justify-content: flex-end;
		}

		.v-c .name {
			grid-area: name1;
		}

		.v-c .name .nl:last-child {
			margin-inline-start: 13vw;
		}

		.v-c .zh {
			grid-area: zh;
		}

		.v-c .body {
			grid-area: body;
			text-align: end;
			justify-items: end;
		}

		.v-c .tstack {
			grid-area: stack;
			justify-content: space-between;
			padding-block-start: 1.25rem;
			border-top: var(--hairline) solid var(--rule);
		}
	}
</style>
